;;; native-runtime-test.el --- Native runtime cache integration -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'ashub)
(defvar emacs-pi-runtime-directory nil)
(defvar emacs-dsh-connection-mode nil)
(defvar emacs-dsh-managed-home nil)

(defmacro ashub-native-test-state (&rest body)
  "Isolate cache, model scheduler and all public runtime queries for BODY."
  (declare (indent 0) (debug t))
  `(let* ((directory (file-truename (make-temp-file "/tmp/ashub-native-" t)))
          (emacs-pi-runtime-directory (expand-file-name "registry" directory))
          (emacs-dsh-connection-mode 'managed) (emacs-dsh-managed-home directory)
          (ashub-native--cache (make-hash-table :test #'eq)) (ashub-native-change-hook nil)
          (ashub-native--activities (make-hash-table :test #'equal))
          (ashub-summary-mode nil) (ashub-summary--timer nil) (ashub-summary--job nil)
          (ashub-summary--sessions (make-hash-table :test #'equal))
          (ashub-summary--cache (make-hash-table :test #'equal))
          (ashub-summary-cache-file (expand-file-name "summary.json" directory))
          (ashub-summary--loaded-file ashub-summary-cache-file)
          (ashub-summary--observing nil) (ashub--instances (make-hash-table :test #'equal))
          (ashub--opening (make-hash-table :test #'equal))
          (ashub--states (make-hash-table :test #'equal))
          (source (list :agent 'pi :root directory))
          (session (ashub-session-create :agent 'pi :source source :id "native"
                                          :path (expand-file-name "history.jsonl" directory)))
          success failure (queries 0) (cancels 0))
     (unwind-protect
         (cl-letf (((symbol-function 'ashub-native--load-client) #'ignore)
                   ((symbol-function 'ashub-native--query)
                    (lambda (_agent ok bad)
                      (cl-incf queries) (setq success ok failure bad)
                      (lambda () (cl-incf cancels)))))
           ,@body)
       (maphash (lambda (_agent entry) (when (functionp (plist-get entry :cancel))
                                        (funcall (plist-get entry :cancel)))) ashub-native--cache)
       (when (timerp ashub-summary--timer) (cancel-timer ashub-summary--timer))
       (delete-directory directory t))))

(defun ashub-native-test-row (session &optional status)
  "Return one minimal public Pi observation for SESSION."
  (list :instance "/private/owned-instance" :generation "generation"
        :sessionFile (ashub-session-path session) :sessionDirectory (plist-get (ashub-session-source session) :root)
        :status (or status "running")))

(ert-deftest ashub-native-cache-renders-background-state-without-runtime-io ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (funcall success (list (ashub-native-test-row session)))
    (should (ashub-native-fresh-p 'pi))
    (let ((native-comp-enable-subr-trampolines nil))
     (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Render started process")))
              ((symbol-function 'call-process) (lambda (&rest _) (ert-fail "Render probed runtime")))
              ((symbol-function 'ashub-native--query) (lambda (&rest _) (ert-fail "Render queried API"))))
      (should (eq (ashub-native-state-for-session session) 'present))
      (should (ashub--session-open-p session))
      (should (string-match-p "后台实例" (ashub--row-status session)))
      (should (ashub-native-session-busy-p session))))))

(ert-deftest ashub-native-cache-force-cancels-and-rejects-late-callback ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (let ((old success))
      (ashub-native-refresh 'pi t)
      (should (= cancels 1))
      (funcall old (list (ashub-native-test-row session)))
      (should-not (ashub-native-fresh-p 'pi))
      (funcall success nil)
      (should (ashub-native-fresh-p 'pi))
      (should (eq (ashub-native-state-for-session session) 'none)))))

(ert-deftest ashub-native-cache-config-change-invalidates-inflight-and-cached-data ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (setq emacs-pi-runtime-directory (expand-file-name "other-registry" directory))
    (funcall success (list (ashub-native-test-row session)))
    (should-not (ashub-native-cached 'pi))
    (should (ashub-native-session-busy-p session))
    (ashub-native-refresh 'pi)
    (should (= queries 2))
    (funcall success nil)
    (should (ashub-native-fresh-p 'pi))))

(ert-deftest ashub-native-cache-errors-retain-observation-but-gate-dispatch ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (funcall success (list (ashub-native-test-row session)))
    (ashub-native-refresh 'pi t)
    (funcall failure "private-token-and-content")
    (should (eq (ashub-native-state-for-session session) 'present))
    (should-not (ashub-native-fresh-p 'pi))
    (should (ashub-native-session-busy-p session))
    (should-not (string-match-p "private-token" (prin1-to-string (ashub-native-cached 'pi))))
    (ashub-native-refresh 'pi)
    (should (= queries 2))))

(ert-deftest ashub-native-cache-pi-scope-unknown-is-not-absence ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (funcall success '((:instance "/owned" :generation "g" :status "running")))
    (should (eq (ashub-native-state-for-session session) 'unknown))
    (should (ashub-native-session-busy-p session))
    (ashub-native-refresh 'pi t)
    (funcall success '((:instance "/owned" :generation "g" :status "running"
                                 :sessionDirectory "/unrelated/storage" :sessionFile "/unrelated/storage/file")))
    (should (eq (ashub-native-state-for-session session) 'none))
    (should-not (ashub-native-session-busy-p session))))

(ert-deftest ashub-native-cache-dsh-presence-is-not-model-idle-or-global-absence ()
  (ashub-native-test-state
    (setf (ashub-session-agent session) 'dsh (ashub-session-source session) '(:agent dsh)
          (ashub-session-metadata session) '(:native-source ("base" "generation" managed)))
    (ashub-native-refresh 'dsh)
    (funcall success '(:status "running" :source ("base" "generation" managed)
                              :sessions ((:session-id "native" :backend-state present))))
    (should (ashub--session-open-p session))
    (should (ashub-native-session-busy-p session))
    (ashub-native-refresh 'dsh t)
    (funcall success '(:status "running" :source ("base" "generation" managed)
                              :sessions ((:session-id "native" :backend-state not-running))))
    (should (eq (ashub-native-state-for-session session) 'not-running))
    (should-not (ashub--session-open-p session))
    (should (ashub-native-session-busy-p session))
    (setf (ashub-session-metadata session) '(:native-source ("base" "different-generation" managed)))
    (should (eq (ashub-native-state-for-session session) 'unknown))
    (ashub-native-refresh 'dsh t)
    (funcall success '(:status "running" :source ("base" "generation" managed) :sessions nil))
    (should (eq (ashub-native-state-for-session session) 'unknown))))

(ert-deftest ashub-native-cache-refresh-does-not-reset-native-summary-clock ()
  (ashub-native-test-state
    (with-temp-file (ashub-session-path session) (insert "{}\n"))
    (puthash (ashub-summary--key session) session ashub-summary--sessions)
    (ashub-summary--observe)
    (let* ((entry (gethash (ashub-summary--key session) ashub-summary--cache))
           (closed (plist-get entry :closed-at)) (changed (plist-get entry :changed-at)))
      (ashub-native-refresh 'pi)
      (funcall success (list (ashub-native-test-row session)))
      (should (ashub--session-open-p session))
      (should-not (ashub-summary--open-p session))
      (ashub-summary--observe)
      (ashub-native-refresh 'pi t)
      (funcall failure "unavailable")
      (ashub-summary--observe)
      (should (equal closed (plist-get entry :closed-at)))
      (should (equal changed (plist-get entry :changed-at))))))

(ert-deftest ashub-native-cache-revalidates-inflight-summary-job ()
  (ashub-native-test-state
    (with-temp-file (ashub-session-path session) (insert "{}\n"))
    (let* ((key (ashub-summary--key session))
           (job (list :key key :stamp (ashub-summary--stamp session))))
      (puthash key session ashub-summary--sessions)
      (setq ashub-summary--job job)
      (ashub-native-refresh 'pi)
      (funcall success nil)
      (should (ashub-summary--valid-job-p job))
      (ashub-native-refresh 'pi t)
      (funcall success (list (ashub-native-test-row session)))
      (should-not (ashub-summary--valid-job-p job)))))

(ert-deftest ashub-native-cache-completion-wakes-headless-optin-scheduler ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi) (funcall success nil)
    (let ((ashub-summary-mode t) callback (ticks 0))
      (cl-letf (((symbol-function 'run-at-time) (lambda (_time _repeat function &rest _) (setq callback function)))
                ((symbol-function 'ashub-summary--tick) (lambda () (cl-incf ticks))))
        (ashub-summary--native-runtime-updated)
        (should (functionp callback))
        (funcall callback)
        (should (= ticks 1))))))

(ert-deftest ashub-native-cache-malformed-public-reply-is-unknown-and-content-free ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (funcall success '((:private "must-not-leak")))
    (should-not (ashub-native-fresh-p 'pi))
    (should (ashub-native-session-busy-p session))
    (should-not (string-match-p "must-not-leak" (prin1-to-string (ashub-native-cached 'pi))))))

(ert-deftest ashub-native-cache-matched-unknown-owner-remains-in-live-view ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (funcall success (list (ashub-native-test-row session "unknown")))
    (should (eq (ashub-native-state-for-session session) 'unknown))
    (should (ashub--session-open-p session))
    (should-not (ashub-summary--open-p session))
    (should (ashub-native-session-busy-p session))))

(ert-deftest ashub-native-cache-ended-record-cannot-overrule-another-root-owner ()
  (ashub-native-test-state
    (ashub-native-refresh 'pi)
    (funcall success (list (ashub-native-test-row session "finished")
                           (list :instance "/other-owned" :generation "other" :status "running"
                                 :sessionFile (expand-file-name "other.jsonl" directory)
                                 :sessionDirectory directory)))
    (should (eq (ashub-native-state-for-session session) 'stopped))
    (should (ashub-native-session-busy-p session))))

(ert-deftest ashub-native-cache-unavailable-api-does-not-fall-back-to-startup ()
  (ashub-native-test-state
    (cl-letf (((symbol-function 'ashub-native--load-client) (lambda (_) (error "private load failure"))))
      (ashub-native-refresh 'pi)
      (should (= queries 0))
      (should (ashub-native-session-busy-p session))
      (should-not (string-match-p "private load" (prin1-to-string (ashub-native-cached 'pi)))))))

(ert-deftest ashub-native-cache-dsh-environment-is-part-of-query-scope ()
  (ashub-native-test-state
    (let ((process-environment (copy-sequence process-environment)))
      (setenv "DSH_HOME" directory)
      (ashub-native-refresh 'dsh)
      (funcall success '(:status "running" :source ("base" "generation" managed) :sessions nil))
      (should (ashub-native-fresh-p 'dsh))
      (setenv "DSH_HOME" (expand-file-name "changed-home" directory))
      (should-not (ashub-native-cached 'dsh))
      (should-not (ashub-native-fresh-p 'dsh)))))

(ert-deftest ashub-native-cache-public-adapter-contract-never-opens-session ()
  (let (calls)
    (cl-letf (((symbol-function 'emacs-pi-inspect-runtimes)
               (lambda (ok &rest args) (push 'pi calls) (should (functionp (plist-get args :on-error)))
                 (funcall ok nil) #'ignore))
              ((symbol-function 'emacs-dsh-inspect-host)
               (lambda (_ok &rest args) (push 'dsh calls) (funcall (plist-get args :on-error) "unknown") #'ignore)))
      (should (functionp (ashub-native--query 'pi #'ignore #'ignore)))
      (should (functionp (ashub-native--query 'dsh #'ignore #'ignore)))
      (should (equal calls '(dsh pi))))))

(defun ashub-native-test-dsh-session (session success)
  "Set up SESSION's exact public Host cache through SUCCESS."
  (setf (ashub-session-agent session) 'dsh (ashub-session-source session) '(:agent dsh)
        (ashub-session-metadata session) '(:native-source ("base" "generation" managed)))
  (funcall success '(:status "running" :source ("base" "generation" managed)
                            :sessions ((:session-id "native" :backend-state not-running)))))

(ert-deftest ashub-native-activity-idle-proof-restores-dsh-summary-dispatch ()
  (ashub-native-test-state
    (ashub-native-refresh 'dsh) (ashub-native-test-dsh-session session success)
    (let (reply)
      (cl-letf (((symbol-function 'emacs-dsh-inspect-session-activity)
                 (lambda (id ok &rest _) (should (equal id "native")) (setq reply ok) #'ignore)))
        (should (ashub-native-session-busy-p session))
        (ashub-native-refresh-activity session)
        (funcall reply '(:source ("base" "generation" managed) :session-id "native" :activity idle
                                :active nil :running nil :cursor 8 :queue-count 0 :pending-input-count 0))
        (should (ashub-native-activity-fresh-p session))
        (should-not (ashub-native-session-busy-p session))
        (setf (plist-get (gethash (ashub-native--activity-key session) ashub-native--activities) :time) 0)
        (should (ashub-native-session-busy-p session))))))

(ert-deftest ashub-native-activity-summary-candidate-and-inflight-result-require-current-idle ()
  (ashub-native-test-state
    (with-temp-file (ashub-session-path session) (insert "{}\n"))
    (ashub-native-refresh 'dsh) (ashub-native-test-dsh-session session success)
    (let* ((key (ashub-summary--key session)) (job (list :key key :stamp (ashub-summary--stamp session))) reply)
      (puthash key session ashub-summary--sessions)
      (ashub-summary--observe)
      (let ((entry (gethash key ashub-summary--cache)))
        (setf (plist-get entry :closed-at) 0 (plist-get entry :changed-at) 0)
        (cl-letf (((symbol-function 'emacs-dsh-inspect-session-activity)
                   (lambda (_id ok &rest _) (setq reply ok) #'ignore)))
          (should-not (ashub-summary--candidate))
          (ashub-native-refresh-activity session)
          (funcall reply '(:source ("base" "generation" managed) :session-id "native" :activity idle
                                  :active nil :running nil :cursor 8 :queue-count 0 :pending-input-count 0))
          (should (eq (ashub-summary--candidate) session))
          (setq ashub-summary--job job)
          (should (ashub-summary--valid-job-p job))
          (ashub-native-refresh-activity session t)
          (funcall reply '(:source ("base" "generation" managed) :session-id "native" :activity input-required
                                  :queue-count 0 :pending-input-count 1))
          (should-not (ashub-summary--valid-job-p job))
          (should-not (ashub-summary--candidate))
          (ashub-summary--observe)
          (should (= (plist-get entry :closed-at) 0))
          (should (= (plist-get entry :changed-at) 0)))))))

(ert-deftest ashub-native-activity-source-mismatch-and-contradictory-idle-fail-closed ()
  (ashub-native-test-state
    (ashub-native-refresh 'dsh) (ashub-native-test-dsh-session session success)
    (let (reply)
      (cl-letf (((symbol-function 'emacs-dsh-inspect-session-activity)
                 (lambda (_id ok &rest _) (setq reply ok) #'ignore)))
        (dolist (result '((:source ("base" "wrong" managed) :session-id "native" :activity idle :active nil :running nil :cursor 8 :queue-count 0 :pending-input-count 0)
                          (:source ("base" "generation" managed) :session-id "native" :activity idle :active nil :running t :cursor 8 :queue-count 0 :pending-input-count 0)
                          (:source ("base" "generation" managed) :session-id "native" :activity idle :active nil :running nil :cursor 8 :queue-count 1 :pending-input-count 0)
                          (:source ("base" "generation" managed) :session-id "native" :activity idle :active nil :running nil :cursor 8 :queue-count 0 :pending-input-count 1)))
          (ashub-native-refresh-activity session t)
          (funcall reply result)
          (should (ashub-native-session-busy-p session)))))))

(ert-deftest ashub-native-activity-busy-and-input-required-are-not-idle ()
  (ashub-native-test-state
    (ashub-native-refresh 'dsh) (ashub-native-test-dsh-session session success)
    (let (reply)
      (cl-letf (((symbol-function 'emacs-dsh-inspect-session-activity)
                 (lambda (_id ok &rest _) (setq reply ok) #'ignore)))
        (dolist (kind '(busy input-required unknown))
          (ashub-native-refresh-activity session t)
          (funcall reply (list :source '("base" "generation" managed) :session-id "native" :activity kind :queue-count 0 :pending-input-count 0))
          (should (ashub-native-session-busy-p session)))))))

(ert-deftest ashub-native-activity-cancel-and-late-reply-cannot-replace-current-proof ()
  (ashub-native-test-state
    (ashub-native-refresh 'dsh) (ashub-native-test-dsh-session session success)
    (let (reply (cancelled 0))
      (cl-letf (((symbol-function 'emacs-dsh-inspect-session-activity)
                 (lambda (_id ok &rest _) (setq reply ok) (lambda () (cl-incf cancelled)))))
        (ashub-native-refresh-activity session)
        (let ((old reply))
          (ashub-native-refresh-activity session t)
          (should (= cancelled 1))
          (funcall old '(:source ("base" "generation" managed) :session-id "native" :activity idle :active nil :running nil :cursor 8 :queue-count 0 :pending-input-count 0))
          (should (ashub-native-session-busy-p session))
          (funcall reply '(:source ("base" "generation" managed) :session-id "native" :activity busy :queue-count 1 :pending-input-count 0))
          (should (ashub-native-session-busy-p session)))))))

(ert-deftest ashub-native-activity-concurrency-is-bounded-across-scheduler-passes ()
  (ashub-native-test-state
    (ashub-native-refresh 'dsh) (ashub-native-test-dsh-session session success)
    (let ((calls 0) sessions)
      (dotimes (index 5)
        (let ((copy (copy-ashub-session session)))
          (setf (ashub-session-id copy) (format "session-%d" index)) (push copy sessions)))
      (cl-letf (((symbol-function 'emacs-dsh-inspect-session-activity)
                 (lambda (&rest _) (cl-incf calls) #'ignore)))
        (ashub-native-refresh-activities sessions)
        (ashub-native-refresh-activities sessions)
        (should (= calls 2))))))

(ert-deftest ashub-native-cache-only-refreshes-requested-agents ()
  (ashub-native-test-state
    (ashub-native-refresh-sources '((:agent claude) (:agent codex)))
    (should (= queries 0))
    (ashub-native-refresh-sources '((:agent pi) (:agent pi) (:agent dsh)))
    (should (= queries 2))))

(provide 'native-runtime-test)
