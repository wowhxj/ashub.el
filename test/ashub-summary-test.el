(ert-deftest ashub-summary-full-input-and-default-gptel-isolation ()
  (ashub-summary-test-with-state
    (let ((session (ashub-summary-test-session))
          (ashub-summary-test-text (concat "BEGIN" (make-string 250000 ?中) "TOOLS:115 passed:END")))
      (ashub-summary-test-ready session)
      (cl-letf (((symbol-function 'gptel-request)
                 (lambda (prompt &rest options)
                   (should (eq gptel-model 'default-model))
                   (should (eq gptel-backend 'default-backend))
                   (should-not gptel-use-context)
                   (should-not gptel-use-tools)
                   (should-not gptel-tools)
                   (should-not gptel-max-tokens)
                   (should-not (plist-get options :stream))
                   (should-not (plist-get options :transforms))
                   (should (string-suffix-p ashub-summary-test-text prompt))
                   (should (> (length prompt) 250000))
                   (setq ashub-summary-test-callback (plist-get options :callback)))))
        (ashub-summary--start session))
      (funcall ashub-summary-test-callback "修复恢复失败，115 项测试通过。" nil)
      (should-not ashub-summary--job)
      (should (equal (ashub-summary-text session) "修复恢复失败，115 项测试通过。"))
      (should (equal (plist-get (ashub-summary-entry session) :model) "default-model")))))

