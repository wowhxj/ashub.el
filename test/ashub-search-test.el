(ert-deftest ashub-search-next-previous-skip-citations-and-diagnostic-buttons ()
  (ashub-search-test-run 'summary
    (dolist (id '(1 2))
      (puthash id (ashub-search-test-session (format "session-%d" id))
               (ashub-search--run-sources run)))
    (setf (ashub-search--run-evidence run)
          '((:source 1 :quote "第一处" :reason "相关")
            (:source 1 :quote "重复引用" :reason "相关")
            (:source 2 :quote "第二处" :reason "相关"))
          (ashub-search--run-claims run)
          '((:text "多处引用" :sources (1 2))))
    (ashub-search--diagnostic run 'codex '(:kind metadata :message "metadata only"))
    (ashub-search--render run)
    (should (eq (lookup-key ashub-search-mode-map (kbd "n")) #'ashub-search-next-result))
    (should (eq (lookup-key ashub-search-mode-map (kbd "p")) #'ashub-search-previous-result))
    (goto-char (point-min))
    (ashub-search-next-result)
    (should (button-get (button-at (point)) 'ashub-result-entry))
    (should (= (button-get (button-at (point)) 'ashub-source) 1))
    (let ((first (point)))
      (ashub-search-next-result)
      (should (= (button-get (button-at (point)) 'ashub-source) 2))
      (let ((last (point)))
        (ashub-search-next-result)
        (should (= (point) last)))
      (ashub-search-previous-result)
      (should (= (point) first))
      (ashub-search-previous-result)
      (should (= (point) first)))))

(ert-deftest ashub-search-excludes-homepage-skip-reasons-in-both-modes ()
  (dolist (mode '(summary full))
    (ashub-search-test-run mode
      (let ((sessions (mapcar #'ashub-search-test-session '("empty-cache" "missing" "failed")))
            reads)
        (cl-letf (((symbol-function 'ashub-summary-entry)
                   (lambda (session)
                     (pcase (ashub-session-id session)
                       ("empty-cache" '(:no-dialogue t))
                       ("failed" '(:error "failed")))))
                  ((symbol-function 'ashub-summary-text) (lambda (_) nil))
                  ((symbol-function 'ashub-search--later) (lambda (_run fn) (funcall fn)))
                  ((symbol-function 'ashub-summary--read)
                   (lambda (session success _failure)
                     (push (ashub-session-id session) reads)
                     (funcall success "[{\"role\":\"user\",\"text\":\"text\"}]")
                     #'ignore))
                  ((symbol-function 'ashub-search--extract) #'ignore))
          (ashub-search--collect run sessions))
        (should (= (ashub-search--run-excluded run) 1))
        (should (= (hash-table-count (ashub-search--run-sources run)) 2))
        (if (eq mode 'summary)
            (should (= (ashub-search--run-missing run) 2))
          (should (equal (reverse reads) '("missing" "failed"))))))))

(ert-deftest ashub-search-progress-publishes-evidence-before-next-batch ()
  (ashub-search-test-run 'full
    (setf (ashub-search--run-chunks run)
          '((:source 2 :text "second") (:source 1 :text "first")))
    (let (pending snapshots)
      (cl-letf (((symbol-function 'ashub-search--pack)
                 (lambda (_run items) (mapcar #'list items)))
                ((symbol-function 'ashub-search--ask)
                 (lambda (_run _data _system success) (setq pending success)))
                ((symbol-function 'ashub-search--render)
                 (lambda (_run)
                   (push (list ashub-search--batch-done ashub-search--batch-total
                               (length (ashub-search--run-evidence run))) snapshots)))
                ((symbol-function 'ashub-search--answer) #'ignore))
        (ashub-search--extract run)
        (should (equal (car snapshots) '(0 2 0)))
        (funcall pending '(:evidence ((:source 1 :quote "first" :reason "match"))))
        (should (member '(1 2 1) snapshots))
        (funcall pending '(:evidence nil))
        (should (equal (car snapshots) '(2 2 1)))))))

(ert-deftest ashub-search-finished-and-failed-do-not-become-cancelled ()
  (dolist (phase '(completed failed))
    (ashub-search-test-run 'summary
      (if (eq phase 'completed)
          (ashub-search--finish run "完成")
        (ashub-search--failed run "failure"))
      (let ((status (ashub-search--run-status run)) (display (buffer-string)))
        (ashub-search-cancel)
        (ashub-search--failed run "late failure")
        (ashub-search--progress run "late progress" 2 3)
        (should (eq (ashub-search--phase run) phase))
        (should (equal status (ashub-search--run-status run)))
        (should (equal display (buffer-string)))))))

(ert-deftest ashub-search-quit-chain-ignores-window-history ()
  (save-window-excursion
    (let ((origin (generate-new-buffer " search origin"))
          (search (get-buffer-create "*ashub search*"))
          (details (get-buffer-create "*ashub details*")))
      (unwind-protect
          (with-current-buffer search
            (ashub-search-mode)
            (setq ashub-search--origin origin
                  ashub-search--run (ashub-search--make :buffer search :mode 'full))
            (let ((run ashub-search--run))
              (puthash 1 (ashub-search-test-session "q-chain") (ashub-search--run-sources run))
              (cl-letf (((symbol-function 'ashub-summary--read)
                         (lambda (_session success _failure)
                           (funcall success "[{\"role\":\"user\",\"text\":\"question\"}]")
                           #'ignore))
                        ((symbol-function 'ashub--display-full-buffer) #'ignore)
                        ((symbol-function 'quit-window)
                         (lambda (&rest _) (ert-fail "must not use quit-window"))))
                (let ((inhibit-read-only t)) (ashub-search--button run 1))
                (ashub-search--open-source (button-at (point-min)))
                (switch-to-buffer details)
                (call-interactively (key-binding (kbd "q")))
                (should (eq (current-buffer) search))
                (ashub-search--finish run "完成")
                (call-interactively (key-binding (kbd "q")))
                (should (eq (current-buffer) origin))
                (should (eq (buffer-local-value 'ashub-search--phase search) 'completed)))))
        (mapc (lambda (buffer) (when (buffer-live-p buffer) (kill-buffer buffer)))
              (list search details origin))))))

(ert-deftest ashub-search-compact-render-groups-sources-and-hides-technical ()
  (ashub-search-test-run 'summary
    (puthash 1 (ashub-search-test-session "unique-session") (ashub-search--run-sources run))
    (setf (ashub-search--run-evidence run)
          '((:source 1 :quote "first evidence" :reason "reason")
            (:source 1 :quote "second evidence" :reason "reason")))
    (ashub-search--diagnostic run 'codex '(:kind metadata :path "/hidden-path" :message "detail"))
    (ashub-search--render run)
    (should (= (how-many "unique-session" (point-min) (point-max)) 1))
    (should (string-search "first evidence" (buffer-string)))
    (should (string-search "second evidence" (buffer-string)))
    (should-not (string-search "/hidden-path" (buffer-string)))
    (should-not (string-search "模型批次" (buffer-string)))
    (goto-char (point-min))
    (ashub-search-next-result)
    (should (button-get (button-at (point)) 'ashub-result-entry))))

(ert-deftest ashub-search-mode-switch-preserves-first-entry ()
  (save-window-excursion
    (let ((origin (generate-new-buffer " search mode origin"))
          (original-require (symbol-function 'require)))
      (unwind-protect
          (cl-letf (((symbol-function 'require)
                     (lambda (feature &rest args)
                       (if (eq feature 'gptel) t
                         (apply original-require feature args))))
                    ((symbol-function 'ashub-configured-sources) (lambda () nil))
                    ((symbol-function 'ashub-search--scan) #'ignore)
                    ((symbol-function 'read-string) (lambda (&rest _) "new question")))
            (switch-to-buffer origin)
            (ashub-search-start 'summary "first question")
            (switch-to-buffer "*ashub search*")
            (should (eq ashub-search--origin origin))
            ;; These are the same commands invoked by the transient menu.
            (ashub-search-full)
            (should (eq (ashub-search--run-mode ashub-search--run) 'full))
            (should (eq ashub-search--origin origin))
            (ashub-search-summary)
            (should (eq ashub-search--origin origin))
            (ashub-search-quit)
            (should (eq (current-buffer) origin)))
        (when-let* ((buffer (get-buffer "*ashub search*"))) (kill-buffer buffer))
        (kill-buffer origin)))))

(ert-deftest ashub-search-hot-reload-preserves-terminal-phase ()
  (dolist (case '(("完成" nil completed) ("证据不足" nil completed)
                  ("已取消" t cancelled) ("失败／覆盖不完整" t failed)))
    (ashub-search-test-run 'summary
      (kill-local-variable 'ashub-search--phase)
      (setf (ashub-search--run-status run) (nth 0 case)
            (ashub-search--run-cancelled run) (nth 1 case))
      (should (eq (ashub-search--phase run) (nth 2 case)))
      (ashub-search-cancel)
      (should (equal (ashub-search--run-status run) (nth 0 case))))))

