(ert-deftest ashub-summary-real-python-reader-is-async-and-full ()
  (ashub-summary-test-with-state
    (let* ((path (expand-file-name "session.jsonl" directory))
           (session (ashub-summary-test-session :path path :source (list :agent 'pi :root directory)))
           value failure cancel)
      (write-region
       (concat "{\"type\":\"session\",\"id\":\"session\",\"version\":3}\n"
               "{\"type\":\"message\",\"id\":\"m\",\"parentId\":null,\"message\":{\"role\":\"user\",\"content\":\"完整主题\"}}\n"
               "{\"type\":\"message\",\"id\":\"tool\",\"parentId\":\"m\",\"message\":{\"role\":\"toolResult\",\"content\":\"tests passed\"}}\n")
       nil path nil 'silent)
      (setq cancel (ashub-summary--read-local session (lambda (text) (setq value text))
                                               (lambda (error) (setq failure error))))
      (unwind-protect
          (progn
            (should-not value)
            (cl-loop repeat 100 until (or value failure) do (accept-process-output nil 0.02))
            (should-not failure)
            (should (string-match-p "完整主题" value))
            (should (string-match-p "tests passed" value)))
        (funcall cancel)))))

