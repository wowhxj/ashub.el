(ert-deftest ashub-summary-errors-backoff-and-stop-after-budget ()
  (ashub-summary-test-with-state
    (let ((session (ashub-summary-test-session)))
      (ashub-summary-test-ready session)
      (dotimes (i 3)
        (ashub-summary--start session)
        (funcall ashub-summary-test-callback nil '(:status "HTTP 500"))
        (should-not (ashub-summary--candidate))
        (cl-incf ashub-summary-test-now (* 300 (expt 2 i))))
      (should-not (ashub-summary--candidate))
      (should (= (length ashub-summary-test-prompts) 3))
      (should (equal (plist-get (ashub-summary-entry session) :error) "HTTP 500"))
      ;; Fresh content is allowed to recover from a previous exhausted budget.
      (setf (ashub-session-last-active session) 900)
      (setq ashub-summary-test-text "有新的内容")
      (ashub-summary--observe)
      (cl-incf ashub-summary-test-now 300)
      (ashub-summary--start session)
      (should (= (length ashub-summary-test-prompts) 4)))))

