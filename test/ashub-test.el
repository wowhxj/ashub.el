    (should-not (equal (ashub-source-key a) (ashub-source-key b)))))

(ert-deftest ashub-visibility-only-hides-known-states ()
  (let ((ashub-show-empty nil) (ashub-show-archived nil))
    (dolist (slot '(:empty :internal :archived))
      (should-not (ashub-session-visible-p (ashub-test-session slot t) nil nil ""))
      (should (ashub-session-visible-p (ashub-test-session slot 'unknown) nil nil "")))
    (let ((ashub-show-empty t) (ashub-show-archived t))
      (should (ashub-session-visible-p (ashub-test-session :empty t :archived t) nil nil ""))
      (should-not (ashub-session-visible-p (ashub-test-session :internal t) nil nil "")))))

(ert-deftest ashub-search-all-completion-jumps-to-selected-session ()
  (ashub-test-with-hub
   (let* ((match (ashub-test-session :agent 'claude :source (ashub-test-source 'claude)
                                     :cwd "/tmp/emacs-pi"
                                     :first-message (concat (make-string 100 ?x) " 功能")))
          (other (ashub-test-session :id "other-session" :cwd "/tmp/other"
                                     :first-message (make-string 200 ?x)))
          (ashub--agent-filter 'codex) (ashub--project-filter "/nothing")
          (ashub--live-only t) candidate)
     (ashub-test-install (list match other))
     (cl-letf (((symbol-function 'completing-read)
                (lambda (_prompt choices &rest _)
                  (setq candidate (car (cl-find-if (lambda (choice)
                                                      (string-match-p "功能" (car choice)))
                                                    choices)))
                  (should (string-match-p "claude.*emacs-pi.*功能" candidate))
                  (should-not (string-match-p "功能" (get-text-property 0 'display candidate)))
                  (let* ((labels (mapcar (lambda (choice)
                                           (get-text-property 0 'display (car choice)))
                                         choices))
                         (agent-positions (mapcar (lambda (label) (string-match "claude" label)) labels)))
                    (should (cl-every #'stringp labels))
                    (should (apply #'= agent-positions))
                    (should (<= (string-width (cadr labels)) 80))
                    (should (string-match-p "…" (cadr labels))))
                  candidate)))
       (ashub-search-all))
     (should-not ashub--agent-filter)
     (should-not ashub--project-filter)
     (should-not ashub--live-only)
     (should (eq (ashub--session-at-point) match)))))

(ert-deftest ashub-search-all-cancel-preserves-existing-filters ()
