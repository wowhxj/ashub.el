;;; ashub-search-test.el --- Semantic history acceptance tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'ashub)

(defvar gptel-tools)
(defvar gptel-use-tools)
(defvar gptel-use-context)

(defun ashub-search-test-session (id &rest fields)
  "Return a local test session with ID and FIELDS."
  (apply #'ashub-session-create
         (append fields (list :agent 'claude :id id :source
                              (list :agent 'claude :root temporary-file-directory)))))

(defmacro ashub-search-test-run (mode &rest body)
  "Execute BODY with a fresh search RUN in MODE."
  (declare (indent 1))
  `(with-temp-buffer
     (ashub-search-mode)
     (let* ((run (ashub-search--make :buffer (current-buffer) :mode ,mode
                                     :query "为什么" :limit 3000 :model 'test))
            (ashub-search--run run))
       (unwind-protect (progn ,@body) (ashub-search--stop run)))))

(ert-deftest ashub-search-entry-does-not-replace-list-jump-or-summary-retry ()
  (should (eq (lookup-key ashub-mode-map (kbd "s")) #'ashub-search-menu))
  (should (eq (lookup-key ashub-mode-map (kbd "j")) #'ashub-search-all))
  (should (eq (lookup-key ashub-mode-map (kbd "r")) #'ashub-summary-retry))
  (should (eq (lookup-key ashub-mode-map (kbd "R")) #'ashub-summary-retry-failed)))

(ert-deftest ashub-search-role-filter-is-strict ()
  (let ((messages (ashub-search--messages
                   "[{\"role\":\"system\",\"text\":\"secret\"},{\"role\":\"user\",\"text\":\"question\"},{\"role\":\"tool\",\"text\":\"hidden\"},{\"role\":\"assistant\",\"text\":\"answer\"}]")))
    (should (equal (mapcar (lambda (row) (plist-get row :text)) messages)
                   '("question" "answer"))))
  (should-error (ashub-search--messages "{\"text\":\"not array\"}")))

(ert-deftest ashub-search-evidence-rejects-invented-id-and-paraphrased-quote ()
  (let* ((batch '((:source 1 :text "采用异步队列，不阻塞界面")))
         (result (ashub-search--evidence
                  '(:evidence ((:source 1 :quote "异步队列" :reason "相关")
                               (:source 2 :quote "异步队列" :reason "伪造来源")
                               (:source 1 :quote "同步队列" :reason "伪造原文")
                               (:source 1 :quote " " :reason "空证据"))) batch)))
    (should (= (length (car result)) 1))
    (should (= (cdr result) 3))))

(ert-deftest ashub-search-answers-require-verified-citations-and-source-coverage ()
  (should (ashub-search--claims '(:claims ((:text "保留两种方案" :sources (1 2)))) '(1 2)))
  (dolist (data '((:claims ((:text "无引用" :sources nil)))
                  (:claims ((:text "编造" :sources (3))))
                  (:claims ((:text "漏来源" :sources (1))))
                  (:claims nil)))
    (should-error (ashub-search--claims data '(1 2)))))

(ert-deftest ashub-search-chunks-cover-entire-long-cjk-text ()
  (ashub-search-test-run 'full
    (let* ((text (concat (make-string 2500 ?前) "中段关键决定" (make-string 2500 ?后)))
           (chunks (ashub-search--chunks run 1 text))
           (groups (ashub-search--pack run chunks)))
      (should (> (length groups) 1))
      (dolist (word '("前" "中段关键决定" "后"))
        (should (seq-some (lambda (chunk) (string-search word (plist-get chunk :text))) chunks)))
      (should (string-suffix-p (make-string 50 ?后) (plist-get (car (last chunks)) :text)))
      (dolist (group groups)
        (should (<= (length (ashub-search--json (vconcat group))) 3000))))))

(ert-deftest ashub-search-summary-never-reads-transcripts-or-generates-summaries ()
  (ashub-search-test-run 'summary
    (let ((archived (ashub-search-test-session "archive" :archived t))
          (missing (ashub-search-test-session "missing"))
          (internal (ashub-search-test-session "internal" :internal t))
          (child (ashub-search-test-session "child" :origin "subagent"))
          extracted)
      (cl-letf (((symbol-function 'ashub-summary-entry)
                 (lambda (_) '(:checked-stamp "same")))
                ((symbol-function 'ashub-summary-text)
                 (lambda (session) (unless (eq session missing) "采用异步队列")))
                ((symbol-function 'ashub-summary--stamp) (lambda (_) "same"))
                ((symbol-function 'ashub-summary--read) (lambda (&rest _) (ert-fail "must not read")))
                ((symbol-function 'ashub-search--extract) (lambda (_) (setq extracted t))))
        (ashub-search--collect run (list archived missing internal child))
        (let ((deadline (+ (float-time) 3)))
          (while (and (not extracted) (< (float-time) deadline)) (accept-process-output nil 0.01)))
        (should extracted)
        (should (= (ashub-search--run-covered run) 1))
        (should (= (ashub-search--run-missing run) 1))
        (should (= (ashub-search--run-excluded run) 2))))))

(ert-deftest ashub-search-request-isolation-and-late-callback-protection ()
  (ashub-search-test-run 'summary
    (let (callback result aborted)
      (cl-letf (((symbol-function 'gptel-request)
                 (lambda (_prompt &rest args)
                   (should-not gptel-tools)
                   (should-not gptel-use-tools)
                   (should-not gptel-use-context)
                   (should-not (plist-get args :transforms))
                   (should-not (plist-get args :stream))
                   (setq callback (plist-get args :callback))))
                ((symbol-function 'gptel-abort) (lambda (_) (setq aborted t))))
        (ashub-search--ask run "[]" "test system" (lambda (data) (setq result data)))
        (ashub-search--stop run)
        (should aborted)
        (funcall callback "{\"evidence\":[]}" nil)
        (should-not result)
        (should-not (ashub-search--run-request-buffer run))))))

(ert-deftest ashub-search-complete-summary-pipeline-with-mocked-model ()
  (ashub-search-test-run 'summary
    (puthash 1 (ashub-search-test-session "real-session") (ashub-search--run-sources run))
    (setf (ashub-search--run-chunks run) '((:source 1 :text "采用异步队列")))
    (let ((calls 0))
      (cl-letf (((symbol-function 'ashub-search--ask)
                 (lambda (_run _data _system success)
                   (cl-incf calls)
                   (funcall success
                            (if (= calls 1)
                                '(:evidence ((:source 1 :quote "异步队列" :reason "方案")))
                              '(:claims ((:text "采用异步处理。" :sources (1)))))))))
        (ashub-search--extract run)
        (should (= calls 2))
        (should (ashub-search--run-claims run))
        (should (string-match-p "完成" (ashub-search--run-status run)))
        (should (string-search "采用异步处理。" (buffer-string)))
        (should (string-search "异步队列" (buffer-string)))))))

(ert-deftest ashub-search-full-reads-dialogue-without-summary-cache ()
  (ashub-search-test-run 'full
    (let ((session (ashub-search-test-session "no-summary" :archived t))
          extracted reads)
      (cl-letf (((symbol-function 'ashub-summary-entry)
                 (lambda (_) nil))
                ((symbol-function 'ashub-summary-text)
                 (lambda (&rest _) (ert-fail "full mode read summary text")))
                ((symbol-function 'ashub-summary--stamp)
                 (lambda (&rest _) (ert-fail "full mode checked summary stamp")))
                ((symbol-function 'ashub-search--later) (lambda (_run fn) (funcall fn)))
                ((symbol-function 'ashub-summary--read)
                 (lambda (item success _failure)
                   (push item reads)
                   (funcall success "[{\"role\":\"system\",\"text\":\"排除系统\"},{\"role\":\"user\",\"text\":\"问题原文\"},{\"role\":\"tool\",\"text\":\"排除工具\"},{\"role\":\"assistant\",\"text\":\"回答原文\"}]")
                   #'ignore))
                ((symbol-function 'ashub-search--extract) (lambda (_) (setq extracted t))))
        (ashub-search--collect run (list session session))
        (should extracted)
        (should (equal reads (list session)))
        (should (= (ashub-search--run-total run) 1))
        (should (= (ashub-search--run-covered run) 1))
        (should (= (ashub-search--run-missing run) 0))
        (let ((chunks (reverse (ashub-search--run-chunks run))))
          (should (equal (mapcar (lambda (row) (plist-get row :text)) chunks)
                         '("问题原文" "回答原文")))
          (should (equal (mapcar (lambda (row) (plist-get row :message)) chunks) '(0 1)))
          (should (equal (mapcar (lambda (row) (plist-get row :role)) chunks)
                         '("user" "assistant"))))))))

(ert-deftest ashub-search-independent-scan-keeps-archives-and-continues-failures ()
  (ashub-search-test-run 'full
    (let* ((sources '((:agent claude) (:agent codex) (:agent pi) (:agent dsh)))
           (archive (ashub-search-test-session "archived" :archived t))
           (ordinary (ashub-search-test-session "ordinary"))
           (ashub--agent-filter 'pi)
           (ashub--project-filter "unrelated-project")
           (ashub--live-only t)
           visited collected)
      (cl-letf (((symbol-function 'ashub-search--later) (lambda (_run fn) (funcall fn)))
                ((symbol-function 'ashub-scan-source)
                 (lambda (source success failure)
                   (push source visited)
                   (pcase (plist-get source :agent)
                     ('claude (funcall success (list archive) '("partial source warning")))
                     ('codex (funcall failure "mock async scan failure"))
                     ('pi (error "mock synchronous scan failure"))
                     ('dsh (funcall success (list ordinary) nil)))
                   #'ignore))
                ((symbol-function 'ashub-search--collect)
                 (lambda (_run sessions) (setq collected sessions))))
        (ashub-search--scan run sources)
        (should (equal (reverse visited) sources))
        (should (equal collected (list archive ordinary)))
        (should (= (length (ashub-search--run-errors run)) 3))
        (should-not (ashub-search--run-cancelled run))))))

(ert-deftest ashub-search-full-read-failure-and-invalid-json-continue ()
  (ashub-search-test-run 'full
    (let ((sessions (mapcar #'ashub-search-test-session '("unreadable" "malformed" "valid")))
          visited extracted)
      (cl-letf (((symbol-function 'ashub-search--later) (lambda (_run fn) (funcall fn)))
                ((symbol-function 'ashub-summary--read)
                 (lambda (session success failure)
                   (push (ashub-session-id session) visited)
                   (pcase (ashub-session-id session)
                     ("unreadable" (funcall failure "mock read failure"))
                     ("malformed" (funcall success "not JSON"))
                     ("valid" (funcall success "[{\"role\":\"assistant\",\"text\":\"保留有效对话\"}]")))
                   #'ignore))
                ((symbol-function 'ashub-search--extract) (lambda (_) (setq extracted t))))
        (ashub-search--collect run sessions)
        (should extracted)
        (should (equal (reverse visited) '("unreadable" "malformed" "valid")))
        (should (= (ashub-search--run-covered run) 1))
        (should (= (hash-table-count (ashub-search--run-sources run)) 3))
        (should (= (length (ashub-search--run-errors run)) 2))
        (should (equal (plist-get (car (ashub-search--run-chunks run)) :text) "保留有效对话"))))))

(ert-deftest ashub-search-cancel-rejects-late-scan-and-read-callbacks ()
  (dolist (operation '(scan read))
    (ashub-search-test-run 'full
      (let (success failure cancelled advanced)
        (cl-letf (((symbol-function 'ashub-scan-source)
                   (lambda (_source ok fail)
                     (setq success ok failure fail)
                     (lambda () (setq cancelled t))))
                  ((symbol-function 'ashub-summary--read)
                   (lambda (_session ok fail)
                     (setq success ok failure fail)
                     (lambda () (setq cancelled t))))
                  ((symbol-function 'ashub-search--later)
                   (lambda (&rest _) (setq advanced t)))
                  ((symbol-function 'ashub-search--extract)
                   (lambda (_) (setq advanced t))))
          (if (eq operation 'scan)
              (ashub-search--scan run '((:agent claude)))
            (ashub-search--collect run (list (ashub-search-test-session "pending"))))
          (ashub-search-cancel)
          (let ((display (buffer-string))
                (total (ashub-search--run-total run)))
            (if (eq operation 'scan)
                (funcall success (list (ashub-search-test-session "late")) nil)
              (funcall success "[{\"role\":\"user\",\"text\":\"迟到原文\"}]"))
            (funcall failure "late failure")
            (should cancelled)
            (should-not advanced)
            (should-not (ashub-search--run-chunks run))
            (should-not (ashub-search--run-errors run))
            (should (= (ashub-search--run-total run) total))
            (should (equal (buffer-string) display))))))))

(ert-deftest ashub-search-request-timeout-rejects-late-model-response ()
  (ashub-search-test-run 'full
    (let (timeout callback request-buffer aborted result)
      (cl-letf (((symbol-function 'run-at-time)
                 (lambda (_delay _repeat fn &rest _) (setq timeout fn) 'mock-timer))
                ((symbol-function 'cancel-timer) #'ignore)
                ((symbol-function 'gptel-request)
                 (lambda (_prompt &rest args)
                   (setq callback (plist-get args :callback)
                         request-buffer (plist-get args :buffer))))
                ((symbol-function 'gptel-abort)
                 (lambda (buffer) (setq aborted buffer))))
        (ashub-search--ask run "[]" "mock system" (lambda (data) (setq result data)))
        (funcall timeout)
        (should (eq aborted request-buffer))
        (should-not (buffer-live-p request-buffer))
        (should-not (ashub-search--run-request-buffer run))
        (should (ashub-search--run-cancelled run))
        (should (member "gptel 请求超时" (ashub-search--run-errors run)))
        (let ((display (buffer-string)))
          (funcall callback "{\"claims\":[]}" nil)
          (funcall timeout)
          (should-not result)
          (should (= (length (ashub-search--run-errors run)) 1))
          (should (equal display (buffer-string))))))))

(ert-deftest ashub-search-open-source-renders-dialogue-and-locates-message-without-agent ()
  (ashub-search-test-run 'full
    (let ((session (ashub-search-test-session "source" :archived t))
          (details (get-buffer-create "*ashub details*")) read-session)
      (unwind-protect
          (cl-letf (((symbol-function 'ashub-summary--read)
                     (lambda (item success _failure)
                       (setq read-session item)
                       (funcall success "[{\"role\":\"system\",\"text\":\"隐藏系统\"},{\"role\":\"user\",\"text\":\"先问问题\"},{\"role\":\"tool\",\"text\":\"隐藏工具\"},{\"role\":\"assistant\",\"text\":\"这里是逐字证据\"}]")
                       #'ignore))
                    ((symbol-function 'ashub--display-full-buffer) #'ignore)
                    ((symbol-function 'ashub-open-session)
                     (lambda (&rest _) (ert-fail "must not restore agent")))
                    ((symbol-function 'ashub-create-session)
                     (lambda (&rest _) (ert-fail "must not create agent")))
                    ((symbol-function 'gptel-request)
                     (lambda (&rest _) (ert-fail "must not request model"))))
            (puthash 1 session (ashub-search--run-sources run))
            (let ((inhibit-read-only t))
              (ashub-search--button run 1 "逐字证据"))
            (ashub-search--open-source (button-at (point-min)))
            (should (eq read-session session))
            (with-current-buffer details
              (should (eq ashub-details--session session))
              (should (string-search "先问问题" ashub-details--conversation))
              (should (string-search "这里是逐字证据" ashub-details--conversation))
              (should-not (string-search "隐藏" ashub-details--conversation))
              (should (= (get-text-property (point) 'ashub-turn-index) 1))))
        (kill-buffer details)))))

(ert-deftest ashub-search-recursive-answer-preserves-all-citations-and-original-evidence ()
  (ashub-search-test-run 'full
    (let* ((evidence (cl-loop for id from 1 to 8
                              collect (list :source id :quote (make-string 700 (+ ?a id))
                                            :reason "原始逐字证据")))
           (original-evidence (copy-tree evidence))
           (evidence-calls 0) (merge-calls 0))
      (setf (ashub-search--run-limit run) 1800
            (ashub-search--run-evidence run) evidence)
      (cl-letf (((symbol-function 'ashub-search--ask)
                 (lambda (_run data _system success)
                   (let* ((items (ashub-search--parse data))
                          (evidence-p (plist-member (car items) :source))
                          (ids (ashub-search--ids items evidence-p)))
                     (if evidence-p (cl-incf evidence-calls) (cl-incf merge-calls))
                     (funcall success
                              (list :claims
                                    (list (list :text (if evidence-p (make-string 500 ?答) "归并回答")
                                                :sources ids))))))))
        (ashub-search--answer run evidence t)
        (should (> evidence-calls 1))
        (should (> merge-calls 1))
        (should (equal (ashub-search--ids (ashub-search--run-claims run) nil)
                       '(1 2 3 4 5 6 7 8)))
        (should (equal (ashub-search--run-evidence run) original-evidence))
        (should (string-prefix-p "搜索结束：完成" (ashub-search--run-status run)))
        (should (string-search "归并回答" (buffer-string)))))))

(ert-deftest ashub-search-merge-lost-citation-fails-with-original-evidence-intact ()
  (ashub-search-test-run 'full
    (let ((evidence '((:source 1 :quote "第一处证据" :reason "方案一")
                      (:source 2 :quote "第二处证据" :reason "方案二"))))
      (setf (ashub-search--run-evidence run) evidence)
      (cl-letf (((symbol-function 'ashub-search--ask)
                 (lambda (_run _data _system success)
                   (funcall success '(:claims ((:text "遗漏第二来源" :sources (1))))))))
        (should-error (ashub-search--answer run evidence t))
        (should-not (ashub-search--run-claims run))
        (should (equal (ashub-search--run-evidence run) evidence))))))

(ert-deftest ashub-search-metadata-groups-by-agent-and-message-with-all-details ()
  (ashub-search-test-run 'summary
    (setq-local ashub-search--show-technical t)
    (let* ((notes '((:kind metadata :path "/first.jsonl" :message "metadata only")
                    (:kind metadata :path "/second.jsonl" :message "metadata only")
                    (:kind metadata :path "/first.jsonl" :message "metadata only")))
           (dsh '(:kind metadata :message "metadata only")))
      (cl-letf (((symbol-function 'ashub-search--later) (lambda (_run fn) (funcall fn)))
                ((symbol-function 'ashub-scan-source)
                 (lambda (source success _failure)
                   (funcall success nil (if (eq (plist-get source :agent) 'codex)
                                            notes (list dsh)))
                   #'ignore))
                ((symbol-function 'ashub-search--collect) #'ignore))
        (ashub-search--scan run '((:agent codex) (:agent dsh))))
      (should-not (ashub-search--run-errors run))
      (should (= (length (ashub-search--run-diagnostics run)) 2))
      (should (equal (reverse (cdr (assoc '(metadata codex "metadata only")
                                         (ashub-search--run-diagnostics run)))) notes))
      (ashub-search--render run)
      (should (string-search "来源元数据提示（非请求错误）：4 项" (buffer-string)))
      (should (string-search "codex · metadata only（3 项）" (buffer-string)))
      (should-not (string-search "/first.jsonl" (buffer-string)))
      (should-not (string-search "覆盖/错误" (buffer-string)))
      (cl-letf (((symbol-function 'ashub-search--ask)
                 (lambda (_run _data _system success)
                   (funcall success '(:claims ((:text "缓存可用" :sources (1))))))))
        (ashub-search--answer run '((:source 1 :quote "缓存" :reason "相关")) t))
      (should (string-prefix-p "搜索结束：完成" (ashub-search--run-status run)))
      (goto-char (point-min))
      (search-forward "codex · metadata only")
      (ashub-search--toggle-diagnostic (button-at (1- (point))))
      (should (string-search "/first.jsonl: metadata only" (buffer-string)))
      (should (string-search "/second.jsonl: metadata only" (buffer-string)))
      (should-not (string-match-p ":kind\\|:message" (buffer-string)))
      ;; Expansion survives unrelated progress renders.
      (ashub-search--render run)
      (should (string-search "/second.jsonl" (buffer-string))))))

