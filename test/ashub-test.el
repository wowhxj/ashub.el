(ert-deftest ashub-full-frame-entry-and-quit-restore-layout ()
  (save-window-excursion
    (let ((left (generate-new-buffer " *ashub-layout-left*"))
          (right (generate-new-buffer " *ashub-layout-right*"))
          (old (frame-parameter nil 'ashub-window-configuration)))
      (unwind-protect
          (progn
            (set-frame-parameter nil 'ashub-window-configuration nil)
            (delete-other-windows)
            (switch-to-buffer left)
            (set-window-buffer (split-window-right) right)
            (cl-letf (((symbol-function 'ashub-refresh) #'ashub--render))
              (ashub)
              (should (= (length (window-list nil 'nomini)) 1))
              (should (eq (current-buffer) (get-buffer "*ashub*")))
              (ashub)
              (ashub-quit))
            (should (= (length (window-list nil 'nomini)) 2))
            (should (eq (window-buffer (selected-window)) left))
            (should (get-buffer-window right))
            (should (buffer-live-p left)) (should (buffer-live-p right))
            (should-not (frame-parameter nil 'ashub-window-configuration)))
        (set-frame-parameter nil 'ashub-window-configuration old)
        (when (get-buffer "*ashub*") (kill-buffer "*ashub*"))
