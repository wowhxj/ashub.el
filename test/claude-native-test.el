;;; claude-native-test.el --- Native Claude routing checks -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'ashub)
(defvar emacs-claude-config-directory nil)

(ert-deftest ashub-claude-restore-uses-exact-native-api-without-terminal ()
  (let* ((root (make-temp-file "ashub-native-claude-" t))
         (emacs-claude-config-directory root)
         (ashub-terminal-runtime-directory (expand-file-name "absent-runtime" root))
         (ashub--opening (make-hash-table :test #'equal))
         (ashub-open-state-change-hook nil)
         (session (ashub-session-create :agent 'claude :source (list :agent 'claude :root root)
                                         :id "exact-native-id" :cwd root))
         (buffer (generate-new-buffer " *native Claude test*")) args shown)
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-claude-open-session)
                   (lambda (id &rest options) (setq args (cons id options)) buffer))
                  ((symbol-function 'pop-to-buffer) (lambda (value &rest _) (setq shown value)))
                  ((symbol-function 'delete-other-windows) #'ignore)
                  ((symbol-function 'ashub--open-terminal) (lambda (&rest _) (ert-fail "Terminal fallback")))
                  ((symbol-function 'ashub-tmux-find) (lambda (&rest _) (ert-fail "No legacy registry: do not probe tmux"))))
          (ashub-open-session session)
          (should (equal (car args) "exact-native-id"))
          (should (equal (file-truename (plist-get (cdr args) :directory)) (file-name-as-directory (file-truename root))))
          (should (plist-member (cdr args) :display))
          (should-not (plist-get (cdr args) :display))
          (should (eq shown buffer)))
      (kill-buffer buffer) (delete-directory root t))))

(ert-deftest ashub-claude-creation-uses-native-api-without-a-picker-or-terminal ()
  (let* ((root (make-temp-file "ashub-create-claude-" t))
         (source (list :agent 'claude :root root))
         (emacs-claude-config-directory root)
         (ashub--opening (make-hash-table :test #'equal))
         (ashub-open-state-change-hook nil)
         (buffer (generate-new-buffer " *native Claude creation*")) args shown)
    (unwind-protect
        (cl-letf (((symbol-function 'ashub--creation-source) (lambda (_) source))
                  ((symbol-function 'emacs-claude-create-session)
                   (lambda (directory &rest options) (setq args (cons directory options)) buffer))
                  ((symbol-function 'ashub--create-terminal) (lambda (&rest _) (ert-fail "Terminal creation")))
                  ((symbol-function 'emacs-claude-chat) (lambda (&rest _) (ert-fail "Interactive picker")))
                  ((symbol-function 'pop-to-buffer) (lambda (value &rest _) (setq shown value)))
                  ((symbol-function 'delete-other-windows) #'ignore))
          (ashub-create-session 'claude root)
          (should (equal (car args) (file-name-as-directory (file-truename root))))
          (should (plist-member (cdr args) :display))
          (should-not (plist-get (cdr args) :display))
          (should (eq shown buffer)))
      (kill-buffer buffer) (delete-directory root t))))

(ert-deftest ashub-claude-restore-rejects-home-mismatch-and-legacy-writer ()
  (let* ((root (make-temp-file "ashub-claude-conflict-" t))
         (source (list :agent 'claude :root root :args nil))
         (session (ashub-session-create :agent 'claude :source source :id "exact-id"))
         (emacs-claude-config-directory "/different/config")
         (ashub-terminal-runtime-directory root))
    (unwind-protect
        (cl-letf (((symbol-function 'emacs-claude-open-session) (lambda (&rest _) (ert-fail "Unsafe native launch"))))
          (should-error (ashub--open-claude session root #'ignore) :type 'user-error)
          (setq emacs-claude-config-directory root)
          (cl-letf (((symbol-function 'ashub-tmux-find) (lambda (&rest _) '(:status "running"))))
            (should-error (ashub--open-claude session root #'ignore) :type 'user-error))
          (cl-letf (((symbol-function 'ashub-tmux-find) (lambda (&rest _) nil)))
            (setf (plist-get source :args) '("--fork-session"))
            (should-error (ashub--open-claude session root #'ignore) :type 'user-error)))
      (delete-directory root t))))

(ert-deftest ashub-native-claude-background-is-live-without-a-ui ()
  (let* ((root temporary-file-directory) (emacs-claude-config-directory root)
         (session (ashub-session-create :agent 'claude :source (list :agent 'claude :root root) :id "native-id")))
    (cl-letf (((symbol-function 'ashub--live-buffer-for-session) #'ignore)
              ((symbol-function 'emacs-claude-session-running-p) (lambda (id) (equal id "native-id"))))
      (should (ashub--session-open-p session))
      (setf (plist-get (ashub-session-source session) :root) "/another-home")
      (should-not (ashub--session-open-p session)))))

(ert-deftest ashub-live-dot-is-green-and-does-not-change-date-markers ()
  (let* ((session (ashub-session-create :agent 'claude :source (list :agent 'claude :root "/tmp")
                                         :id "id" :last-active 100 :time-source 'updated))
         (ashub--opening (make-hash-table :test #'equal))
         (ashub--delete-marks (make-hash-table :test #'equal))
         (ashub-summary-mode nil))
    (with-temp-buffer
      (ashub-mode)
      (cl-letf (((symbol-function 'ashub--session-open-p) (lambda (_) t))
                ((symbol-function 'ashub-session-display-time-source) (lambda (_) 'updated)))
        (let* ((label (ashub--row-label session (list session))) (dot (string-match "●" label)))
          (should dot)
          (should (eq (get-text-property dot 'face label) 'success))
          (should (string-match-p (regexp-quote (concat (format-time-string "%Y-%m-%d %H:%M" (seconds-to-time 100)) "*")) label)))))))

(provide 'claude-native-test)
