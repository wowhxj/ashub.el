;;; package-stage.el --- Relocated offline package probe -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'ert)
(let* ((root (getenv "STAGE_ROOT")) (installed (expand-file-name "installed" root)))
  (dolist (name '("ashub" "emacs-pi" "emacs-dsh"))
    (load (expand-file-name (concat name "/" name "-autoloads.el") installed) nil t)))
(require 'ashub)
(require 'emacs-pi)
(require 'emacs-dsh)
(defun stage-wait (predicate)
  (let ((end (+ (float-time) 15)))
    (while (and (not (funcall predicate)) (< (float-time) end)) (accept-process-output nil .03))
    (should (funcall predicate))))
(let* ((root (getenv "STAGE_ROOT")) (installed (expand-file-name "installed" root))
       (work (expand-file-name "work" root))
       (emacs-pi-persistent t) (emacs-pi-runtime-directory (expand-file-name "pr" root))
       (emacs-pi-executable (getenv "STAGE_PI_FAKE"))
       (ashub-terminal-runtime-directory (expand-file-name "terminal-absent" root))
       (emacs-dsh-connection-mode 'managed) (emacs-dsh-managed-persistent t)
       (emacs-dsh-managed-home (expand-file-name "fixture-home" root))
       (emacs-dsh-managed-directory work) (emacs-dsh-runtime-directory (expand-file-name "dr" root))
       (emacs-dsh-managed-command (expand-file-name "fixture-dsh" root))
       (file (expand-file-name "history.jsonl" root)) buffer failure connection generation)
  (make-directory work)
  (dolist (resource (list emacs-pi-runtime--bridge-file emacs-dsh-runtime--helper ashub-tmux--helper-file))
    (should (file-readable-p resource))
    (should (string-prefix-p (file-name-as-directory installed) resource))
    (should-not (string-match-p "/build/" resource)))
  (should-not (ashub-tmux-list))
  (should-not (file-exists-p ashub-terminal-runtime-directory))
  (dolist (spec (list (list emacs-pi-runtime--bridge-file #'emacs-pi-runtime--node)
                     (list emacs-dsh-runtime--helper #'emacs-dsh-runtime--node)
                     (list ashub-tmux--helper-file #'ashub-tmux--tools)))
    (let ((resource (car spec)))
      (rename-file resource (concat resource ".held"))
      (unwind-protect (should-error (funcall (cadr spec)))
        (rename-file (concat resource ".held") resource))))
  (with-temp-file file (insert (emacs-pi--jencode (emacs-pi--jobject "type" "session" "id" "staged-pi" "cwd" work)) "\n"))
  (cl-labels ((open ()
               (setq buffer nil failure nil)
               (emacs-pi-open-session file :directory work :display 'none
                                     :on-ready (lambda (value) (setq buffer value))
                                     :on-error (lambda (value) (setq failure value)))
               (stage-wait (lambda () (or buffer failure))) (should-not failure)))
    (unwind-protect
        (progn
          (open)
          (setq generation (emacs-pi--jget (emacs-pi-session-runtime-state (buffer-local-value 'emacs-pi--session buffer)) "generation"))
          (kill-buffer buffer) (setq buffer nil) (accept-process-output nil .15)
          (open)
          (should (equal generation (emacs-pi--jget (emacs-pi-session-runtime-state (buffer-local-value 'emacs-pi--session buffer)) "generation")))
          (with-current-buffer buffer (emacs-pi-quit))
          (stage-wait (lambda () (not (buffer-live-p buffer)))))
      (when (buffer-live-p buffer) (with-current-buffer buffer (emacs-pi-quit))
            (stage-wait (lambda () (not (buffer-live-p buffer)))))))
  ;; Fake CLI is an external test dependency, not shipped product content.
  (with-temp-file emacs-dsh-managed-command
    (insert "#!/bin/sh\nexec " (shell-quote-argument (getenv "STAGE_NODE")) " "
            (shell-quote-argument (getenv "STAGE_DSH_FAKE")) " \"$@\"\n"))
  (set-file-modes emacs-dsh-managed-command #o700)
  (unwind-protect
      (progn
        (emacs-dsh--managed-start (lambda (value error) (setq connection value failure error)))
        (stage-wait (lambda () (or connection failure))) (should-not failure)
        (let (state)
          (emacs-dsh-inspect-host (lambda (value) (setq state value)) :on-error (lambda (error) (setq failure error)))
          (stage-wait (lambda () (or state failure))) (should-not failure)
          (should (equal (plist-get state :status) "running"))
          (should (eq (plist-get (plist-get state :capabilities) :quit) 'detach))))
    (let (done)
      (emacs-dsh-runtime-shutdown (lambda (_state error) (setq done t failure error)))
      (stage-wait (lambda () done)) (should-not failure)))
  (princ "PASS relocated autoloads, compiled helpers, missing-resource refusal, Pi detach/reattach/finish, DSH managed Host\n"))
;;; package-stage.el ends here
