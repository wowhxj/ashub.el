;;; pi-attach-missing-integration.el --- Missing resource attach probe -*- lexical-binding: t; -*-
(require 'ert)
(require 'ashub)
(require 'emacs-pi)

(defun ashub-pi-attach-wait (predicate)
  "Service real pipes until PREDICATE, bounded to twelve seconds."
  (let ((end (+ (float-time) 12)))
    (while (and (not (funcall predicate)) (< (float-time) end)) (accept-process-output nil .02))
    (should (funcall predicate))))

(ert-deftest ashub-pi-attach-missing-history-cwd-executable-keeps-generation ()
  (let* ((root (file-truename (make-temp-file "/tmp/pi-attach-ui-" t)))
         (project (expand-file-name "project" root))
         (file (expand-file-name "history.jsonl" project))
         (program (expand-file-name "fake-pi.py" root))
         (emacs-pi-runtime-directory (expand-file-name "runtime" root)) (emacs-pi-persistent t)
         (emacs-pi-executable program) (ashub--instances (make-hash-table :test #'equal))
         (ashub--opening (make-hash-table :test #'equal))
         (ashub-open-state-change-hook nil) (ashub-summary-mode nil)
         (session (ashub-session-create :agent 'pi :source (list :agent 'pi :root project)
                                        :id "missing-resource-test" :path file :cwd project))
         buffer failure generation completed)
    (make-directory project)
    (copy-file (expand-file-name "test/fake-pi.py" (file-name-directory (locate-library "emacs-pi"))) program)
    (set-file-modes program #o700)
    (with-temp-file file (insert (emacs-pi--jencode (emacs-pi--jobject "type" "session" "id" "missing-resource-test" "cwd" project)) "\n"))
    (cl-labels ((open ()
                 (setq buffer nil failure nil)
                 (emacs-pi-open-session file :display 'none :on-ready (lambda (value) (setq buffer value))
                                       :on-error (lambda (value) (setq failure value)))
                 (ashub-pi-attach-wait (lambda () (or buffer failure))) (should-not failure)))
      (unwind-protect
          (progn
            (open)
            (setq generation (emacs-pi--jget (emacs-pi-session-runtime-state (buffer-local-value 'emacs-pi--session buffer)) "generation"))
            (kill-buffer buffer) (setq buffer nil)
            (accept-process-output nil .15)
            (delete-file file) (delete-directory project) (delete-file program)
            ;; Hub must not run source/cwd/relocation checks before native owner lookup.
            (cl-letf (((symbol-function 'pop-to-buffer) (lambda (value &rest _) (setq buffer value))))
              (ashub-open-session session)
              (ashub-pi-attach-wait (lambda () (buffer-live-p buffer))))
            (should (buffer-live-p buffer))
            (should (equal generation (emacs-pi--jget (emacs-pi-session-runtime-state (buffer-local-value 'emacs-pi--session buffer)) "generation")))
            (should-not (file-exists-p file)) (should-not (file-exists-p project)) (should-not (file-exists-p program))
            (let (same error)
              (emacs-pi-open-session file :display 'none :on-ready (lambda (value) (setq same value))
                                    :on-error (lambda (value) (setq error value)))
              (ashub-pi-attach-wait (lambda () (or same error)))
              (should-not error) (should (eq same buffer)))
            (with-current-buffer buffer (emacs-pi-quit))
            (ashub-pi-attach-wait (lambda () (not (buffer-live-p buffer))))
            ;; Proven absence does not permit startup when the resources are gone.
            (setq buffer nil failure nil)
            (emacs-pi-open-session file :display 'none :on-ready (lambda (value) (setq buffer value))
                                  :on-error (lambda (value) (setq failure value)))
            (ashub-pi-attach-wait (lambda () (or buffer failure)))
            (should failure) (should-not buffer) (setq completed t))
        ;; A callback assertion can fail before BUFFER is assigned. Discover
        ;; only this fixture's UI and finish it before removing any registry.
        (maphash
         (lambda (_ candidate)
           (when (and (buffer-live-p candidate)
                      (equal file (emacs-pi-session-session-file (buffer-local-value 'emacs-pi--session candidate))))
             (with-current-buffer candidate (emacs-pi-quit))
             (ashub-pi-attach-wait (lambda () (not (buffer-live-p candidate)))))) emacs-pi--chats)
        (when completed (delete-directory root t))))))
;;; pi-attach-missing-integration.el ends here
