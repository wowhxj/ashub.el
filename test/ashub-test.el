          (should (equal (if (eq (car case) 'other) (buffer-string) inserted)
                         (cadr case))))))))

(ert-deftest ashub-pi-relocation-fork-verifies-history-before-deleting-source ()
  (let* ((root (make-temp-file "ashub-pi-fork" t))
         (old (expand-file-name "jev-rime" root))
         (new (expand-file-name "rime-jev" root))
         (source-file (expand-file-name "source.jsonl" root))
         (fork-file (expand-file-name "fork.jsonl" root))
         (ashub-project-relocations (list (cons old new)))
         (session (ashub-session-create :agent 'pi :source (ashub-test-source 'pi root)
                                        :id "source-id" :path source-file :cwd old))
         ready failure buffer)
    (unwind-protect
        (progn
          (make-directory new)
          (with-temp-file source-file
            (insert (format "{\"type\":\"session\",\"id\":\"source-id\",\"cwd\":%s}\n"
                            (json-serialize old)))
            (insert "{\"type\":\"message\",\"message\":{\"role\":\"user\",\"content\":\"keep me\"}}\n"))
          (should (ashub--pi-relocation-fork-needed-p session
                                                     (file-name-as-directory (file-truename new))))
          (cl-letf (((symbol-function 'ashub--root) (lambda (path) path))
                    ((symbol-function 'emacs-pi-session-session-file) (lambda (_session) fork-file))
                    ((symbol-function 'emacs-pi-fork-session-file)
                     (lambda (path &rest options)
                       (should (file-equal-p path source-file))
                       (should (equal (plist-get options :directory)
                                      (file-name-as-directory (file-truename new))))
                       (with-temp-file fork-file
                         (insert (format "{\"type\":\"session\",\"id\":\"fork-id\",\"cwd\":%s,\"parentSession\":%s}\n"
                                         (json-serialize (file-truename new))
                                         (json-serialize (file-truename source-file))))
                         (insert "{\"type\":\"message\",\"message\":{\"role\":\"user\",\"content\":\"keep me\"}}\n")
                         (insert "{\"type\":\"custom\",\"customType\":\"startup-state\"}\n"))
                       (setq buffer (generate-new-buffer " *ashub-fork-test*"))
                       (with-current-buffer buffer (setq-local emacs-pi--session 'fake-session))
                       (funcall (plist-get options :on-ready) buffer))))
            (ashub--pi-relocation-fork session (file-name-as-directory (file-truename new))
                                       (lambda (value) (setq ready value))
                                       (lambda (value) (setq failure value))))
          (should-not failure)
          (should (eq ready buffer))
          (should-not (file-exists-p source-file))
          (should (equal (ashub--pi-jsonl-records fork-file)
                         '(((type . "message") (message (role . "user")
                                                     (content . "keep me")))
                           ((type . "custom") (customType . "startup-state")))))
          (should-not (gethash "parentSession" (ashub--pi-read-header fork-file))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

