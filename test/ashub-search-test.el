(ert-deftest ashub-search-stale-and-unknown-summaries-remain-searchable-not-errors ()
  (ashub-search-test-run 'summary
    (setq-local ashub-search--show-technical t)
    (let ((stale (ashub-search-test-session "stale" :path "/gone-rollout.jsonl"))
          (unknown (ashub-search-test-session "unknown"))
          extracted)
      (cl-letf (((symbol-function 'ashub-search--later) (lambda (_run fn) (funcall fn)))
                ((symbol-function 'ashub-summary-entry) (lambda (_) '(:checked-stamp "old")))
                ((symbol-function 'ashub-summary-text) (lambda (_) "缓存仍可搜索"))
                ((symbol-function 'ashub-summary--stamp)
                 (lambda (session) (if (eq session stale) "new" (error "revision unavailable"))))
                ((symbol-function 'ashub-summary--read)
                 (lambda (&rest _) (ert-fail "summary must not read missing transcript")))
                ((symbol-function 'ashub-search--extract) (lambda (_) (setq extracted t))))
        (ashub-search--collect run (list stale unknown)))
      (should extracted)
      (should (= (ashub-search--run-covered run) 2))
      (should (= (ashub-search--run-stale run) 1))
      (should (= (ashub-search--run-missing run) 0))
      (should-not (ashub-search--run-errors run))
      (should (= (length (ashub-search--run-chunks run)) 2))
      (ashub-search--render run)
      (should (string-search "摘要过期提示（不保证最新）：1 项" (buffer-string)))
      (should (string-search "摘要时效未知（不保证最新）：1 项" (buffer-string)))
      (should-not (string-search "覆盖/错误" (buffer-string))))))

