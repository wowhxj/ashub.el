;;; tmux-test.el --- Persistent runtime interface tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'ashub-tmux)
(defvar ghostel-module-auto-install nil)
(when (getenv "ASHUB_TMUX_GHOSTEL")
  (let ((ghostel-module-auto-install nil)) (require 'ghostel)))

(ert-deftest ashub-tmux-environment-is-literal-and-first-binding-wins ()
  (let ((environment (ashub-tmux--environment '("A=" "A=second" "B=line1\nline2" "UNSET"))))
    (should (equal (gethash "A" environment) ""))
    (should (equal (gethash "B" environment) "line1\nline2"))
    (should-not (gethash "UNSET" environment))))

(ert-deftest ashub-tmux-missing-resource-is-actionable-no-fallback ()
  (let ((ashub-tmux--helper-file "/nonexistent/ashub-terminal.py"))
    (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Unexpected launch"))))
      (should-error (ashub-tmux-list) :type 'user-error))))

(ert-deftest ashub-tmux-real-public-lifecycle ()
  (skip-unless (executable-find ashub-tmux-program))
  (let* ((parent (make-temp-file "/tmp/ashub-tmux-ert-" t))
         (ashub-terminal-runtime-directory (expand-file-name "run" parent))
         (source (list :agent 'claude :root (expand-file-name "source" parent)))
         (program (executable-find ashub-python-program))
         (args '("-c" "import time; time.sleep(60)"))
         state)
    (unwind-protect
        (progn
          (should-not (ashub-tmux-list))
          (should-not (file-exists-p ashub-terminal-runtime-directory))
          (setq state (ashub-tmux-ensure source parent program args process-environment "ert-exact-id"))
          (should (equal (plist-get state :status) "running"))
          (let ((again (ashub-tmux-ensure source parent program args process-environment "ert-exact-id")))
            (should (equal (plist-get again :generation) (plist-get state :generation)))
            (should (equal (plist-get again :childPid) (plist-get state :childPid))))
          (should (= (length (ashub-tmux-list source)) 1))
          (should (equal (plist-get (ashub-tmux-inspect (plist-get state :runtimeId)) :status) "running"))
          (should (member "attach-session"
                          (ashub-tmux-attach-command (plist-get state :runtimeId) (plist-get state :generation))))
          (should-error (ashub-tmux-finish (plist-get state :runtimeId) "old-generation") :type 'user-error)
          (should (equal (plist-get (ashub-tmux-finish (plist-get state :runtimeId)
                                                     (plist-get state :generation)) :status) "finished")))
      (when state
        (ignore-errors (ashub-tmux-finish (plist-get state :runtimeId) (plist-get state :generation))))
      (delete-directory parent t))))

(require 'ashub-open)

(defun ashub-tmux-test-renderer (buffer program &optional args _identity)
  "A real PTY renderer for lifecycle tests, not a fake transport."
  (with-current-buffer buffer
    (fundamental-mode)
    (let ((process-environment (cons "TERM=xterm-256color" process-environment)))
      (let ((process (make-process :name "ashub-test-renderer" :buffer buffer
                                   :command (cons program args) :connection-type 'pty :noquery t)))
        (add-hook 'kill-buffer-hook (lambda () (when (process-live-p process) (delete-process process))) nil t)
        process))))

(defun ashub-tmux-test-wait (predicate)
  "Wait at most five seconds for PREDICATE, without selecting a buffer."
  (let ((deadline (+ (float-time) 5)) result)
    (while (and (not (setq result (funcall predicate))) (< (float-time) deadline))
      (accept-process-output nil 0.04))
    (should result)
    result))

(ert-deftest ashub-terminal-real-entry-detach-reconnect-and-explicit-finish ()
  (skip-unless (executable-find ashub-tmux-program))
  (let* ((parent (make-temp-file "/tmp/ashub-entry-" t))
         (ashub-terminal-runtime-directory (expand-file-name "run" parent))
         (ashub--instances (make-hash-table :test #'equal))
         (ashub--opening (make-hash-table :test #'equal))
         (python (executable-find ashub-python-program))
         (fixture (expand-file-name "agent.py" parent))
         (ghostel-module-auto-install nil)
         (renderer (if (getenv "ASHUB_TMUX_GHOSTEL")
                       (progn (require 'ghostel) (symbol-function 'ghostel-exec))
                     #'ashub-tmux-test-renderer)) buffers)
    (unwind-protect
        (cl-letf (((symbol-function 'ghostel-exec) renderer))
          (with-temp-file fixture
            (insert "import os,json,time\nopen(os.environ['TEST_OUT'],'w').write(json.dumps(dict(pid=os.getpid())))\ntime.sleep(60)\n"))
          (dolist (agent '(claude codex hermes))
            (let* ((root (expand-file-name (symbol-name agent) parent))
                   (output (expand-file-name (concat (symbol-name agent) ".json") parent))
                   (source (list :agent agent :root root :program python
                                 :args (list fixture)
                                 :environment (list (concat "TEST_OUT=" output))))
                   buffer state)
              (make-directory root)
              (ashub--create-terminal source parent (lambda (value) (setq buffer value) (push value buffers)))
              (setq state (buffer-local-value 'ashub--terminal-state buffer))
              (ashub-tmux-test-wait (lambda () (file-exists-p output)))
              (with-current-buffer buffer
                (when (getenv "ASHUB_TMUX_GHOSTEL")
                  (should (derived-mode-p 'ghostel-mode))
                  (should (bound-and-true-p ghostel--term)))
                (should (eq (key-binding (kbd "C-c C-q")) #'ashub-terminal-finish)))
              (kill-buffer buffer)
              (should (equal (plist-get (ashub-tmux-inspect (plist-get state :runtimeId)) :status) "running"))
              (ashub--attach-terminal state source (lambda (value) (setq buffer value) (push value buffers)))
              (should (equal (plist-get (buffer-local-value 'ashub--terminal-state buffer) :childPid)
                             (plist-get state :childPid)))
              (with-current-buffer buffer
                (cl-letf (((symbol-function 'ashub-tmux-finish) (lambda (&rest _) (user-error "Unknown completion"))))
                  (should-error (ashub-terminal-finish) :type 'user-error)))
              (should (buffer-live-p buffer))
              (with-current-buffer buffer (ashub-terminal-finish))
              (should-not (buffer-live-p buffer))
              (should (file-exists-p output)))))
      (dolist (buffer buffers) (when (buffer-live-p buffer) (kill-buffer buffer)))
      (dolist (state (ignore-errors (ashub-tmux-list)))
        (ignore-errors (ashub-tmux-finish (plist-get state :runtimeId) (plist-get state :generation))))
      (delete-directory parent t))))

(ert-deftest ashub-terminal-attaches-before-history-directory-or-program-checks ()
  (skip-unless (executable-find ashub-tmux-program))
  (let* ((parent (make-temp-file "/tmp/ashub-attach-first-" t))
         (root (expand-file-name "source" parent)) (project (expand-file-name "project" parent))
         (fixture (expand-file-name "agent.py" parent))
         (ashub-terminal-runtime-directory (expand-file-name "run" parent))
         (ashub--instances (make-hash-table :test #'equal))
         (ashub--opening (make-hash-table :test #'equal))
         (source (list :agent 'claude :root root :program (executable-find ashub-python-program)
                       :args (list fixture)))
         (session (ashub-session-create :agent 'claude :source source :id "exact-id"
                                         :cwd project :path (expand-file-name "retained-history.jsonl" parent)))
         buffers first shown)
    (unwind-protect
        (cl-letf (((symbol-function 'ghostel-exec) #'ashub-tmux-test-renderer))
          (make-directory root) (make-directory project)
          (with-temp-file fixture (insert "import time\ntime.sleep(60)\n"))
          (with-temp-file (ashub-session-path session) (insert "retained history"))
          (ashub--open-terminal session project (lambda (buffer) (push buffer buffers) (setq first buffer)))
          (let ((pid (plist-get (buffer-local-value 'ashub--terminal-state first) :childPid)))
            (kill-buffer first)
            (delete-directory project) (delete-directory root)
            (setf (plist-get source :program) "/missing/agent"
                  (ashub-session-archived session) t)
            (cl-letf (((symbol-function 'ashub--restore-directory) (lambda (&rest _) (ert-fail "Must attach first")))
                      ((symbol-function 'pop-to-buffer) (lambda (buffer &rest _) (setq shown buffer) (push buffer buffers)))
                      ((symbol-function 'delete-other-windows) #'ignore))
              (ashub-open-session session))
            (should (buffer-live-p shown))
            (should (equal pid (plist-get (buffer-local-value 'ashub--terminal-state shown) :childPid)))
            (should (eq (ashub-session-archived session) t))
            (with-current-buffer shown (ashub-terminal-finish))
            (should (file-exists-p (ashub-session-path session)))))
      (dolist (buffer buffers) (when (buffer-live-p buffer) (kill-buffer buffer)))
      (dolist (state (ignore-errors (ashub-tmux-list)))
        (ignore-errors (ashub-tmux-finish (plist-get state :runtimeId) (plist-get state :generation))))
      (delete-directory parent t))))

(provide 'tmux-test)
;;; tmux-test.el ends here
