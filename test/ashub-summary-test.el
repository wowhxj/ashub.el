;;; ashub-summary-test.el --- Background summary tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'ashub)

(defvar ashub-summary-test-now nil)
(defvar ashub-summary-test-open nil)
(defvar ashub-summary-test-text nil)
(defvar ashub-summary-test-callback nil)
(defvar ashub-summary-test-prompts nil)
(defvar gptel-backend nil)
(defvar gptel-model nil)
(defvar gptel-use-context nil)
(defvar gptel-use-tools nil)
(defvar gptel-tools nil)
(defvar gptel-max-tokens nil)

(defmacro ashub-summary-test-with-state (&rest body)
  "Run BODY with private state, fake time, and an isolated mock gptel."
  (declare (indent 0) (debug t))
  `(let* ((directory (make-temp-file "ashub-summary-test-" t))
          (ashub-summary-cache-file (expand-file-name "summaries.json" directory))
          (ashub-summary--loaded-file ashub-summary-cache-file)
          (ashub-summary--cache (make-hash-table :test #'equal))
          (ashub-summary--sessions (make-hash-table :test #'equal))
          (ashub-summary--scans nil) (ashub-summary--scan-generation 0)
          (ashub-summary--timer nil) (ashub-summary--observation-timer nil)
          (ashub-summary--observing nil)
          (ashub-summary--job nil)
          (ashub-summary--diagnostic nil) (ashub-summary--last-request 0)
          (ashub-summary--next-request 0) (ashub-summary--backend-failures 0)
          (ashub-summary--paused-error nil)
          (ashub-summary--next-scan most-positive-fixnum)
          (ashub-summary-mode t)
          (ashub-summary-idle-delay 300) (ashub-summary-stable-delay 300)
          (ashub-summary-request-interval 60) (ashub-summary-check-interval 30)
          (ashub-summary-read-timeout 120) (ashub-summary-request-timeout 180)
          (ashub-summary-retry-delay 300) (ashub-summary-retry-max-delay 3600)
          (ashub-summary-max-attempts 3)
          (ashub-summary-test-now 1000) (ashub-summary-test-open nil)
          (ashub-summary-test-text "完整对话：主题、最终方案和全部测试证据")
          ashub-summary-test-callback ashub-summary-test-prompts
          (original-require (symbol-function 'require))
          (gptel-backend 'default-backend) (gptel-model 'default-model))
     (unwind-protect
         (cl-letf (((symbol-function 'float-time) (lambda (&optional _) ashub-summary-test-now))
                   ((symbol-function 'ashub-summary--open-p) (lambda (_) ashub-summary-test-open))
                   ((symbol-function 'ashub-summary--notify) #'ignore)
                   ((symbol-function 'require)
                    (lambda (feature &optional filename noerror)
                      (if (eq feature 'gptel) t
                        (funcall original-require feature filename noerror))))
                   ((symbol-function 'gptel-abort) #'ignore)
                   ((symbol-function 'ashub-summary--read-adapter)
                    (lambda (_session success _failure)
                      (funcall success ashub-summary-test-text) #'ignore))
                   ((symbol-function 'gptel-request)
                    (lambda (prompt &rest options)
                      (push prompt ashub-summary-test-prompts)
                      (setq ashub-summary-test-callback (plist-get options :callback)))))
           ,@body)
       (when ashub-summary--job (ashub-summary--release ashub-summary--job))
       (when (timerp ashub-summary--timer) (cancel-timer ashub-summary--timer))
       (when (timerp ashub-summary--observation-timer) (cancel-timer ashub-summary--observation-timer))
       (delete-directory directory t))))

(defun ashub-summary-test-session (&rest properties)
  "Return a source-qualified test session with PROPERTIES."
  (apply #'ashub-session-create
         (append properties (list :agent 'pi :source (list :agent 'pi :root temporary-file-directory)
                                  :id "session" :last-active 100 :first-message "原始首句"))))

(defun ashub-summary-test-ready (session)
  "Register SESSION and let its default stability/closed windows elapse."
  (ashub-summary--register (ashub-session-source session) (list session))
  (cl-incf ashub-summary-test-now 300))

(ert-deftest ashub-summary-opt-in-not-enabled-by-loading ()
  (should-not (default-value 'ashub-summary-mode)))

(ert-deftest ashub-summary-delays-are-configurable ()
  (ashub-summary-test-with-state
    (let ((session (ashub-summary-test-session))
          (ashub-summary-idle-delay 600) (ashub-summary-stable-delay 20))
      (ashub-summary-test-ready session)
      (should-not (ashub-summary--candidate))
      (setq ashub-summary-test-now 1599)
      (should-not (ashub-summary--candidate))
      (setq ashub-summary-test-now 1600)
      (should (eq session (ashub-summary--candidate))))))

