(ert-deftest ashub-summary-ui-three-columns-and-first-message-fallback ()
  (ashub-summary-test-with-state
    (let* ((session (ashub-summary-test-session :metadata '(:reference (:last "原始末句"))))
           (key (ashub-summary--key session)))
      (should (equal (ashub--row-text session) "原始首句"))
      (should (equal (ashub--last-user-text session) "原始末句"))
      (should (equal (ashub--summary-status session) "待生成"))
      (puthash key (list :summary "修复恢复失败，待验证。"
                        :checked-stamp (ashub-summary--stamp session)) ashub-summary--cache)
      (should (equal (ashub--row-text session) "修复恢复失败，待验证。"))
      (should (equal (ashub--summary-status session) "已生成"))
      (with-temp-buffer
        (ashub-mode)
        (let ((layout (ashub--table-layout (list session)))
              (inhibit-read-only t)
              (ashub--states (make-hash-table :test #'equal)))
          (ashub--insert-table-header layout)
          (ashub--insert-row session (list session) layout)
          (should (string-match-p "摘要 +用户末句 +摘要状态" (buffer-string)))
          (should (string-match-p "修复" (buffer-string)))
          (goto-char (point-min))
          (should (text-property-search-forward 'help-echo "修复恢复失败，待验证。" #'equal))
          (should (string-match-p "原始末句" (buffer-string)))
          (should (string-match-p "已生成" (buffer-string)))
          (should-not (string-match-p "原始首句" (buffer-string))))))))

