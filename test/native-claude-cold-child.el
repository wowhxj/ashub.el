;;; native-claude-cold-child.el --- Read-only cold Emacs liveness probe -*- lexical-binding: t; -*-
(require 'ashub)
(require 'cl-lib)
(setq native-comp-enable-subr-trampolines nil)
(unless (and (not (featurep 'emacs-claude))
             (not (fboundp 'emacs-claude-session-running-p)))
  (error "Cold probe unexpectedly preloaded the Claude client"))
(setq emacs-claude-directory (getenv "ASHUB_COLD_HOLDER_ROOT")
      emacs-claude-config-directory (getenv "ASHUB_COLD_CONFIG_ROOT"))
(let* ((source (list :agent 'claude :root emacs-claude-config-directory))
       (session (ashub-session-create :agent 'claude :source source :id (getenv "ASHUB_COLD_ID"))))
  (when (ashub--session-open-p session) (error "Cold state unexpectedly marked live before client loading"))
  (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (error "Probe must not start a process")))
            ((symbol-function 'call-process) (lambda (&rest _) (error "Probe must not run a CLI")))
            ((symbol-function 'start-process) (lambda (&rest _) (error "Probe must not start a process"))))
    (ashub-native-refresh-sources (list source))
    (unless (and (featurep 'emacs-claude) (ashub--session-open-p session))
      (error "Fresh Emacs failed to discover the existing Claude holder")))
  (princ "PASS cold Emacs discovers existing Claude holder without starting any process\n"))
