;;; runtime-inventory-test.el --- Durable runtime inventory tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'ashub)

(defmacro ashub-inventory-test-with-state (&rest body)
  "Isolate all inventory, summary cache and registry state for BODY."
  (declare (indent 0) (debug t))
  `(let* ((parent (make-temp-file "/tmp/ashub-inventory-" t))
          (ashub-terminal-runtime-directory (expand-file-name "run" parent))
          (ashub-tmux-snapshot-root (expand-file-name ashub-terminal-runtime-directory))
          (ashub-tmux-snapshot nil) (ashub-tmux-snapshot-status 'ready)
          (ashub-tmux-snapshot-time (float-time)) (ashub-tmux-snapshot-error nil)
          (ashub-tmux-snapshot-change-hook nil) (ashub-tmux--snapshot-generation 0)
          (ashub-tmux--snapshot-cancel nil) (ashub-tmux--snapshot-retry-at 0)
          (ashub--instances (make-hash-table :test #'equal))
          (ashub--opening (make-hash-table :test #'equal))
          (ashub-summary-mode nil)
          (ashub-summary-cache-file (expand-file-name "summary.json" parent))
          (ashub-summary--loaded-file ashub-summary-cache-file)
          (ashub-summary--cache (make-hash-table :test #'equal))
          (ashub-summary--sessions (make-hash-table :test #'equal))
          (ashub-summary--job nil) (ashub-summary--timer nil)
          (source (list :agent 'codex :root (ashub--root (expand-file-name "home" parent))))
          (state (list :runtimeId "aaaaaaaaaaaaaaaaaaaaaaaa" :generation "generation"
                       :source (list :agent "codex" :root (plist-get source :root) :profile nil)
                       :directory parent :createdAt 123.0 :sessionId nil :status "running"
                       :controllerPid nil :attachedClients 0)))
     (unwind-protect (progn (ignore source state) ,@body)
       (when ashub-tmux--snapshot-cancel (funcall ashub-tmux--snapshot-cancel))
       (when (timerp ashub-summary--timer) (cancel-timer ashub-summary--timer))
       (delete-directory parent t))))

(ert-deftest ashub-inventory-native-id-sync-preserves-ownership-generation ()
  (ashub-inventory-test-with-state
    (with-temp-buffer
      (setq-local ashub--terminal-state (copy-tree state))
      (setq ashub-tmux-snapshot (list (plist-put (copy-tree state) :sessionId "native-id")))
      (ashub-terminal--runtime-updated)
      (should (equal (plist-get ashub--terminal-state :sessionId) "native-id"))
      (setq ashub-tmux-snapshot (list (plist-put (copy-tree state) :generation "replacement")))
      (ashub-terminal--runtime-updated)
      (should (equal (plist-get ashub--terminal-state :generation) "generation"))
      (should (equal (plist-get ashub--terminal-state :sessionId) "native-id")))))

(ert-deftest ashub-inventory-stale-instance-cache-does-not-link-old-native-id ()
  (ashub-inventory-test-with-state
    (with-temp-buffer
      (let* ((buffer (current-buffer))
             (session (ashub-session-create :agent 'codex :id "old-native-id" :source source))
             (process (make-pipe-process :name "ashub-native-id-test" :noquery t)))
        (unwind-protect
            (progn
              (setq-local ashub--terminal-state (plist-put (copy-tree state) :sessionId "new-native-id")
                          ashub--terminal-process process)
              (puthash (ashub-session-key session) (list :buffer buffer :process process) ashub--instances)
              (should-not (ashub--live-buffer-for-session session)))
          (delete-process process))))))

(ert-deftest ashub-inventory-previous-native-ids-are-reserved-not-current ()
  (ashub-inventory-test-with-state
    (let ((session (ashub-session-create :agent 'codex :id "old-native-id" :source source)))
      (setq state (plist-put state :sessionId "current-native-id"))
      (setq state (plist-put state :previousSessionIds '("old-native-id")))
      (setq ashub-tmux-snapshot (list state))
      (should-not (ashub-tmux-state-for-session session))
      (should (ashub-tmux-session-busy-p session))
      (cl-letf (((symbol-function 'ashub-tmux-list) (lambda (&rest _) (list state))))
        (should-error (ashub-tmux-find source "old-native-id") :type 'user-error)
        (should (equal (plist-get (ashub-tmux-find source "current-native-id") :runtimeId)
                       (plist-get state :runtimeId)))))))

(ert-deftest ashub-inventory-unknown-owner-blocks-other-native-id-in-storage-home ()
  (ashub-inventory-test-with-state
    (setq state (plist-put state :sessionId "last-known-id"))
    (setq state (plist-put state :status "unknown"))
    (setq ashub-tmux-snapshot (list state))
    (let ((session (ashub-session-create :agent 'codex :id "possibly-rotated-id" :source source)))
      (should (ashub-tmux-session-busy-p session))
      (cl-letf (((symbol-function 'ashub-tmux-list) (lambda (&rest _) (list state))))
        (should-error (ashub-tmux-find source "possibly-rotated-id") :type 'user-error)
        (should (eq state (ashub-tmux-find source nil (plist-get state :runtimeId))))))))

(ert-deftest ashub-inventory-managed-buffer-never-uses-renderer-pid-as-native-pid ()
  (ashub-inventory-test-with-state
    (with-temp-buffer
      (setq-local ashub--terminal-state state)
      (cl-letf (((symbol-function 'insert-file-contents) (lambda (&rest _) (ert-fail "renderer PID was inspected"))))
        (should-not (ashub--claude-terminal-session-id '(:agent claude :root "/tmp")))))))

(ert-deftest ashub-inventory-managed-lifecycle-flags-cannot-redirect-native-identity ()
  (dolist (pair '((claude . "--fork-session") (hermes . "-c") (hermes . "--profile=other") (hermes . "-pother")))
    (let ((source (list :agent (car pair) :root "/tmp" :program "/bin/cat" :args (list (cdr pair)))))
      (should-error (ashub--terminal-command-for-source source "/tmp"))
      (should-error (ashub--terminal-command-for-source source "/tmp" "exact-id")))))

(defun ashub-inventory-test-wait (predicate)
  "Await PREDICATE for at most five seconds."
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.04))
    (should (funcall predicate))))

(ert-deftest ashub-inventory-real-async-list-is-readonly ()
  (skip-unless (executable-find ashub-tmux-program))
  (ashub-inventory-test-with-state
    (let (done result)
      (ashub-tmux--list-async (lambda (value) (setq result value done t))
                              (lambda (error) (ert-fail error)))
      (ashub-inventory-test-wait (lambda () done))
      (should-not result)
      (should-not (file-exists-p ashub-terminal-runtime-directory)))))

(ert-deftest ashub-inventory-real-owner-is-visible-with-no-ui-or-history ()
  (skip-unless (executable-find ashub-tmux-program))
  (ashub-inventory-test-with-state
    (unwind-protect
        (progn
          (setq state (ashub-tmux-ensure source parent (executable-find ashub-python-program)
                                        '("-I" "-c" "import time; time.sleep(60)") process-environment))
          (ashub-tmux-refresh-snapshot t)
          (ashub-inventory-test-wait (lambda () (eq ashub-tmux-snapshot-status 'ready)))
          (with-temp-buffer
            (ashub-mode)
            (let* ((items (ashub--visible-sessions)) (session (car items)))
              (should (= (length items) 1))
              (should (equal (plist-get (ashub-session-metadata session) :runtime-id)
                             (plist-get state :runtimeId)))
              (should-not (ashub--live-buffer-for-session session))
              (should (ashub--session-open-p session))
              (should (equal (plist-get (ashub-tmux-find (ashub-session-source session)
                                                       (ashub-session-id session)
                                                       (plist-get (ashub-session-metadata session) :runtime-id)) :childPid)
                             (plist-get state :childPid)))))
          (ashub-tmux-finish (plist-get state :runtimeId) (plist-get state :generation))
          (ashub-tmux-refresh-snapshot t)
          (ashub-inventory-test-wait (lambda () (eq ashub-tmux-snapshot-status 'ready)))
          (with-temp-buffer (ashub-mode) (should-not (ashub--all-sessions))))
      (dolist (runtime (ignore-errors (ashub-tmux-list)))
        (ignore-errors (ashub-tmux-finish (plist-get runtime :runtimeId) (plist-get runtime :generation)))))))

(ert-deftest ashub-inventory-cancel-is-silent-and-cleans-manager-buffers ()
  (skip-unless (executable-find ashub-tmux-program))
  (ashub-inventory-test-with-state
    (let ((calls 0))
      (funcall (ashub-tmux--list-async (lambda (_) (cl-incf calls)) (lambda (_) (cl-incf calls))))
      (accept-process-output nil 0.05)
      (should (zerop calls))
      (should-not (seq-some (lambda (buffer) (string-prefix-p " *ashub runtime inventory" (buffer-name buffer)))
                            (buffer-list))))))

(ert-deftest ashub-inventory-old-callback-cannot-overwrite-new-generation ()
  (ashub-inventory-test-with-state
    (let (callbacks (cancellations 0))
      (cl-letf (((symbol-function 'ashub-tmux--list-async)
                 (lambda (success _failure)
                   (setq callbacks (append callbacks (list success)))
                   (lambda () (cl-incf cancellations)))))
        (ashub-tmux-refresh-snapshot t)
        (ashub-tmux-refresh-snapshot t)
        (funcall (car callbacks) (list state))
        (should (eq ashub-tmux-snapshot-status 'loading))
        (should-not ashub-tmux-snapshot)
        (funcall (cadr callbacks) nil)
        (should (eq ashub-tmux-snapshot-status 'ready))
        (should (ashub-tmux-snapshot-fresh-p))
        (should (= cancellations 1))))))

(ert-deftest ashub-inventory-cache-is-bound-to-registry-identity ()
  (ashub-inventory-test-with-state
    (setq ashub-tmux-snapshot (list state))
    (should (ashub-tmux-current-snapshot))
    (let ((ashub-terminal-runtime-directory (expand-file-name "other" parent)))
      (should-not (ashub-tmux-current-snapshot))
      (should-not (ashub-tmux-snapshot-fresh-p)))))

(ert-deftest ashub-inventory-pending-runtime-survives-without-ui-and-render-is-pure ()
  (ashub-inventory-test-with-state
    (setq ashub-tmux-snapshot (list state))
    (with-temp-buffer
      (ashub-mode)
      (let ((items (ashub--visible-sessions)))
        (should (= (length items) 1))
        (let ((session (car items)))
          (should (equal (plist-get (ashub-session-metadata session) :runtime-id) (plist-get state :runtimeId)))
          (should (ashub--session-open-p session))
          (should-not (ashub--live-buffer-for-session session))
          (should (string-match-p "后台实例" (ashub--row-status session)))
          (cl-letf (((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Render must not probe processes"))))
            (ashub--render))
          (goto-char (point-min))
          (let ((inhibit-read-only t))
            (insert (propertize "runtime\n" 'ashub-session session)))
          (goto-char (point-min))
          (should-error (ashub-copy-id) :type 'user-error)
          (let (opened)
            (cl-letf (((symbol-function 'ashub-tmux-find)
                       (lambda (_source _native-id runtime-id)
                         (should (equal runtime-id (plist-get state :runtimeId))) state))
                      ((symbol-function 'ashub-tmux-refresh-snapshot) #'ignore)
                      ((symbol-function 'ashub--attach-terminal)
                       (lambda (runtime _source ready &optional _key)
                         (setq opened runtime) (funcall ready (current-buffer))))
                      ((symbol-function 'ashub--terminal-launch) (lambda (&rest _) (ert-fail "Must not resume a guessed ID")))
                      ((symbol-function 'pop-to-buffer) #'ignore)
                      ((symbol-function 'delete-other-windows) #'ignore))
              (ashub-open-session session))
            (should (eq opened state))))))))

(ert-deftest ashub-inventory-indexed-history-is-not-duplicated-and-detached-is-open ()
  (ashub-inventory-test-with-state
    (setf (plist-get state :sessionId) "native-id")
    (setq ashub-tmux-snapshot (list state))
    (let ((session (ashub-session-create :agent 'codex :source source :id "native-id" :cwd parent)))
      (with-temp-buffer
        (ashub-mode)
        (puthash (ashub-source-key source) (list :source source :items (list session) :loaded t :status 'ready) ashub--states)
        (should (= (length (ashub--all-sessions)) 1))
        (should (ashub--session-open-p session))
        (should (ashub-summary--open-p session))
        (setf (plist-get state :status) "exited")
        (should-not (ashub--session-open-p session))))))

(ert-deftest ashub-inventory-stale-and-unknown-summary-dispatch-is-blocked ()
  (ashub-inventory-test-with-state
    (let ((session (ashub-session-create :agent 'codex :source source :id "native-id")) (queries 0))
      (cl-letf (((symbol-function 'ashub-tmux-refresh-snapshot) (lambda (&rest _) (cl-incf queries))))
        (setq ashub-tmux-snapshot-time (- (float-time) 100))
        (should (ashub-tmux-session-busy-p session))
        (should (= queries 1))
        (setq ashub-tmux-snapshot-status 'unknown)
        (should (ashub-tmux-session-busy-p session))
        (setq ashub-tmux-snapshot-status 'ready ashub-tmux-snapshot-time (float-time))
        (should-not (ashub-tmux-session-busy-p session))
        ;; Unknown native ID blocks all profiles sharing the physical home.
        (setf (plist-get (plist-get state :source) :profile) "other")
        (setq ashub-tmux-snapshot (list state))
        (should (ashub-tmux-session-busy-p session))))))

(ert-deftest ashub-inventory-refresh-does-not-reset-idle-summary-stability ()
  (ashub-inventory-test-with-state
    (let* ((session (ashub-session-create :agent 'codex :source source :id "native-id"))
           (key (ashub-summary--key session)) (closed (- (float-time) 1000))
           (ashub-summary-idle-delay 1) (ashub-summary-stable-delay 1) (queries 0))
      (puthash key session ashub-summary--sessions)
      (puthash key (list :observed "r1" :changed-at closed :closed-at closed) ashub-summary--cache)
      (setq ashub-tmux-snapshot-time (- (float-time) 100))
      (cl-letf (((symbol-function 'ashub-summary--stamp) (lambda (_) "r1"))
                ((symbol-function 'ashub-tmux-refresh-snapshot) (lambda (&rest _) (cl-incf queries))))
        (ashub-summary--observe)
        (should (equal (plist-get (gethash key ashub-summary--cache) :closed-at) closed))
        (should-not (ashub-summary--candidate))
        (should (= queries 1))
        (setq ashub-tmux-snapshot-time (float-time))
        (should (eq (ashub-summary--candidate) session))
        (should (equal (plist-get (gethash key ashub-summary--cache) :closed-at) closed))))))

(ert-deftest ashub-inventory-fresh-result-wakes-summary-without-a-hub ()
  (ashub-inventory-test-with-state
    (let ((ashub-summary-mode t) (ticks 0))
      (cl-letf (((symbol-function 'ashub-summary--tick) (lambda () (cl-incf ticks))))
        (ashub-summary--runtime-updated)
        (ashub-inventory-test-wait (lambda () (= ticks 1)))))))

(provide 'runtime-inventory-test)
