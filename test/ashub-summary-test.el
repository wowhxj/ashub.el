(ert-deftest ashub-summary-dsh-detects-host-cap-smaller-than-request ()
  (let ((reader (symbol-function 'ashub-summary--read-adapter)))
    (ashub-summary-test-with-state
      (let ((session (ashub-summary-test-session :agent 'dsh
                                                :source '(:agent dsh :root "configured-host"))))
        (ashub-summary-test-ready session)
        (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                  ((symbol-function 'ashub--dsh-source-check) #'ignore)
                  ((symbol-function 'ashub-summary--read-adapter) reader)
                  ((symbol-function 'emacs-dsh-read-session)
                   (lambda (_id success &rest _options)
                     (funcall success '(:max-messages 2 :messages
                                                      ((:role user :text "主题")
                                                       (:role assistant :text "进展")))) #'ignore)))
          (ashub-summary--start session))
        (should-not ashub-summary-test-prompts)
        (should-not ashub-summary--job)
        (should (string-match-p "retrieval limit" (plist-get (ashub-summary-entry session) :error)))))))

(ert-deftest ashub-summary-search-retains-original-prompts-with-ai-summary ()
  (ashub-summary-test-with-state
    (let* ((session (ashub-summary-test-session :metadata '(:reference (:last "原始末句"))))
           (key (ashub-summary--key session)))
      (puthash key '(:summary "一句 AI 摘要") ashub-summary--cache)
      (let ((candidate (ashub--session-search-candidate session 120)))
        (should (string-match-p "一句 AI 摘要" candidate))
        (should (string-match-p "原始首句" candidate))
        (should (string-match-p "原始末句" candidate))))))

(ert-deftest ashub-summary-native-probes-cannot-create-an-observation-loop ()
  (ashub-summary-test-with-state
    (let ((session (ashub-summary-test-session)))
      (ashub-summary-test-ready session)
      (unwind-protect
          (progn
            (add-hook 'buffer-list-update-hook #'ashub-summary--buffer-change)
            (cl-letf (((symbol-function 'ashub-summary--open-p)
                       (lambda (_)
                         ;; Claude's native identity probe reads a PID record
                         ;; in a temporary buffer, which triggers this hook.
                         (with-temp-buffer
                           (run-hooks 'buffer-list-update-hook))
                         nil)))
              (ashub-summary--observe))
            (should-not ashub-summary--observation-timer))
        (remove-hook 'buffer-list-update-hook #'ashub-summary--buffer-change)))))

(ert-deftest ashub-summary-enabled-mode-backfills-on-timers-without-hub ()
  (ashub-summary-test-with-state
    (let* ((source (list :agent 'pi :root directory
                         :scan-function (lambda (_source success _failure)
                                          (funcall success (list (ashub-summary-test-session
                                                                 :source (list :agent 'pi :root directory))) nil)
                                          #'ignore)))
           (ashub-sources (list source)) (ashub-extra-sources nil)
           (ashub-summary-idle-delay 0.01) (ashub-summary-stable-delay 0.01)
           (ashub-summary-check-interval 0.01) (ashub-summary-request-interval 0.01))
      (cl-letf (((symbol-function 'gptel-request)
                 (lambda (prompt &rest options)
                   (push prompt ashub-summary-test-prompts)
                   (funcall (plist-get options :callback) "后台自动补齐成功。" nil))))
        (unwind-protect
            (progn
              (ashub-summary-mode 1)
              (sleep-for 0.03)
              (should (= (hash-table-count ashub-summary--sessions) 1))
              (should-not ashub-summary-test-prompts)
              (cl-incf ashub-summary-test-now 1)
              (sleep-for 0.05)
              (should (= (length ashub-summary-test-prompts) 1))
              (should-not ashub-summary--job)
              (sleep-for 0.03)
              (should (= (length ashub-summary-test-prompts) 1)))
          (ashub-summary-mode -1))))))

(ert-deftest ashub-summary-disable-before-first-read-preserves-disk-cache ()
  (ashub-summary-test-with-state
    (let ((session (ashub-summary-test-session)))
      (puthash (ashub-summary--key session) '(:summary "上次已保存的摘要") ashub-summary--cache)
      (ashub-summary--save)
      (setq ashub-summary--cache (make-hash-table :test #'equal)
            ashub-summary--loaded-file nil)
      (ashub-summary-mode -1)
      (setq ashub-summary--cache (make-hash-table :test #'equal)
            ashub-summary--loaded-file nil)
      (should (equal (ashub-summary-text session) "上次已保存的摘要")))))

(ert-deftest ashub-summary-dsh-source-update-is-a-revision-hint ()
  (ashub-summary-test-with-state
    (let* ((session (ashub-summary-test-session :agent 'dsh
                                               :source '(:agent dsh :root "configured-host")
                                               :metadata '(:updated-at 1)))
           (before (ashub-summary--stamp session)))
      (setf (ashub-session-metadata session) '(:updated-at 2))
      (should-not (equal before (ashub-summary--stamp session))))))

(ert-deftest ashub-summary-codex-rollout-can-change-with-stable-db-revision ()
  (ashub-summary-test-with-state
    (let* ((path (expand-file-name "rollout.jsonl" directory))
           (session (ashub-summary-test-session :agent 'codex :path path
                                                :metadata '(:summary-revision "unchanged-db"))))
      (write-region "old" nil path nil 'silent)
      (let ((before (ashub-summary--stamp session)))
        (write-region "new CLI turn appended" nil path nil 'silent)
        (should-not (equal before (ashub-summary--stamp session)))))))

(ert-deftest ashub-summary-column-status-is-explicit-without-mixing-message-text ()
  (ashub-summary-test-with-state
    (let* ((session (ashub-summary-test-session :metadata '(:reference (:last "用户最终要求"))))
           (key (ashub-summary--key session))
           (entry (list :summary "旧摘要仍然可读。" :checked-stamp (ashub-summary--stamp session))))
      (puthash key entry ashub-summary--cache)
      (should (equal (ashub--summary-status session) "已生成"))
      (setf (ashub-session-last-active session) 500)
      (should (equal (ashub--summary-status session) "待更新"))
      (setf (plist-get entry :error) "服务请求失败")
      (puthash key entry ashub-summary--cache)
      (should (equal (ashub--summary-status session) "摘要失败"))
      (should (equal (ashub--row-text session) "旧摘要仍然可读。"))
      (let ((ashub-summary--job (list :key key)))
        (should (equal (ashub--summary-status session) "摘要中"))
        (should (equal (ashub--last-user-text session) "用户最终要求")))
      (remhash key ashub-summary--cache)
      (should (equal (ashub--row-text session) "原始首句"))
      (let ((ashub-summary-mode nil))
        (should (equal (ashub--summary-status session) "未启用")))
      (let ((ashub-summary--paused-error "需要修复模型配置"))
        (should (equal (ashub--summary-status session) "已暂停")))
      (should-not ashub-summary-test-prompts))))

