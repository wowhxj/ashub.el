;;; native-claude-integration.el --- Hub/native client with offline CLI -*- lexical-binding: t; -*-
(require 'ert)
(require 'ashub)
(require 'emacs-claude)
(defvar ashub-claude-test-fake (getenv "ASHUB_CLAUDE_FAKE"))
(defconst ashub-claude-cold-child
  (expand-file-name "native-claude-cold-child.el"
                    (file-name-directory (or load-file-name buffer-file-name))))

(ert-deftest ashub-native-claude-creation-starts-distinct-native-chats ()
  (let* ((tmp (file-name-as-directory (file-truename (make-temp-file "/tmp/ashub-create-claude-" t))))
         (emacs-claude-directory (expand-file-name "state/" tmp))
         (emacs-claude-config-directory (expand-file-name "home/" tmp))
         (emacs-claude-executable ashub-claude-test-fake) (emacs-claude-extra-arguments nil)
         (ashub-terminal-runtime-directory (expand-file-name "no-tmux" tmp))
         (ashub-open-state-change-hook nil) (ashub--opening (make-hash-table :test #'equal))
         (source (list :agent 'claude :root emacs-claude-config-directory)) buffers ids)
    (unwind-protect
        (cl-letf (((symbol-function 'ashub--creation-source) (lambda (_) source))
                  ((symbol-function 'pop-to-buffer) (lambda (buffer &rest _) (push buffer buffers)))
                  ((symbol-function 'delete-other-windows) #'ignore)
                  ((symbol-function 'ashub--create-terminal) (lambda (&rest _) (ert-fail "Used terminal"))))
          (dotimes (_ 2) (ashub-create-session 'claude tmp))
          (should (= 2 (length buffers)))
          (dolist (buffer buffers)
            (should (eq (buffer-local-value 'major-mode buffer) 'emacs-claude-chat-mode))
            (let ((id (buffer-local-value 'emacs-claude--id buffer)))
              (push id ids)
              (with-timeout (10 (ert-fail "Fixture holder did not start"))
                (while (not (emacs-claude-session-running-p id)) (accept-process-output nil .01)))
              (should (eq (emacs-claude--get (emacs-claude--meta id) "resumed") :false))))
          (should-not (equal (car ids) (cadr ids)))
          (should-not (file-exists-p ashub-terminal-runtime-directory)))
      (dolist (buffer buffers)
        (when (buffer-live-p buffer) (with-current-buffer buffer (emacs-claude-quit))))
      (with-timeout (10 (ert-fail "Fixture holders did not exit"))
        (while (seq-some #'emacs-claude-session-running-p ids) (accept-process-output nil .05)))
      (delete-directory tmp t))))

(ert-deftest ashub-native-claude-public-restore-detach-and-reconnect ()
  (should (file-executable-p ashub-claude-test-fake))
  (let* ((tmp (file-name-as-directory (file-truename (make-temp-file "/tmp/ashub-claude-native-" t))))
         (root (expand-file-name "project/" tmp))
         (emacs-claude-directory (expand-file-name "state/" tmp))
         (emacs-claude-config-directory (expand-file-name "home/" tmp))
         (emacs-claude-executable ashub-claude-test-fake) (emacs-claude-extra-arguments nil)
         (ashub-terminal-runtime-directory (expand-file-name "no-tmux" tmp))
         (ashub-open-state-change-hook nil) (ashub--opening (make-hash-table :test #'equal))
         (id (emacs-claude--uuid))
         (session (ashub-session-create :agent 'claude :id id :cwd root
                                         :source (list :agent 'claude :root emacs-claude-config-directory)))
         buffer pid)
    (make-directory root t)
    (let ((history (emacs-claude--transcript-file id root)))
      (make-directory (file-name-directory history) t)
      (with-temp-file history (insert ""))
      (setf (ashub-session-path session) history))
    (unwind-protect
        (cl-letf (((symbol-function 'pop-to-buffer) (lambda (value &rest _) (setq buffer value)))
                  ((symbol-function 'delete-other-windows) #'ignore)
                  ((symbol-function 'ashub--open-terminal) (lambda (&rest _) (ert-fail "Used terminal"))))
          (ashub-open-session session)
          (should (buffer-live-p buffer))
          (should (eq (buffer-local-value 'major-mode buffer) 'emacs-claude-chat-mode))
          (should (equal (buffer-local-value 'emacs-claude--id buffer) id))
          (should (eq (emacs-claude--get (emacs-claude--meta id) "resumed") t))
          (with-timeout (10 (ert-fail "Fixture holder did not start"))
            (while (not (emacs-claude-session-running-p id)) (accept-process-output nil .01)))
          (setq pid (emacs-claude--pid id))
          (should (ashub--session-open-p session))
          (kill-buffer buffer)
          (should (emacs-claude-session-running-p id))
          (should-not (ashub--live-buffer-for-session session))
          (should (ashub--session-open-p session))
          ;; A separate -Q Emacs has no client feature, functions or chat buffers.
          (let ((process-environment (copy-sequence process-environment)))
            (setenv "ASHUB_COLD_HOLDER_ROOT" emacs-claude-directory)
            (setenv "ASHUB_COLD_CONFIG_ROOT" emacs-claude-config-directory)
            (setenv "ASHUB_COLD_ID" id)
            (with-temp-buffer
              (should
               (zerop
                (call-process
                 (expand-file-name invocation-name invocation-directory) nil (current-buffer) nil
                 "--batch" "-Q" "-L" (file-name-directory (locate-library "ashub"))
                 "-L" (file-name-directory (locate-library "emacs-claude"))
                 "-L" (file-name-directory (locate-library "markdown-mode"))
                 "--eval" "(setq load-prefer-newer t)" "-l" ashub-claude-cold-child)))
              (should (string-match-p "PASS cold Emacs" (buffer-string)))))
          (ashub-open-session session)
          (should (equal pid (emacs-claude--pid id)))
          (should (eq (ashub--live-buffer-for-session session) buffer))
          (should-not (file-exists-p ashub-terminal-runtime-directory))
          (with-current-buffer buffer (emacs-claude-quit))
          (with-timeout (10 (ert-fail "Fixture Claude did not exit"))
            (while (emacs-claude-session-running-p id) (accept-process-output nil .05))))
      (when (emacs-claude-session-running-p id)
        (let ((own (or (emacs-claude-session-buffer id) (emacs-claude-open-session id :directory root :display nil))))
          (with-current-buffer own (emacs-claude-quit))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory tmp t))))
